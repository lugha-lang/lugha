// chanping: two tasks bounce a counter over two unbuffered channels, n
// round trips. Stresses channel sends and receives and task switches.

fun main(args: string[], console: Console) {
    let n = parse_i64(args[1]).unwrap();
    let ping: Chan<i64> = Chan.new();
    let pong: Chan<i64> = Chan.new();
    let echo = spawn fun() {
        while let .Some(v) = ping.recv() {
            pong.send(v + 1);
        }
    }();
    let mut v = 0;
    for i in 0..n {
        ping.send(v);
        v = pong.recv().unwrap();
    }
    ping.close();
    echo.join();
    console.println(v);
}
