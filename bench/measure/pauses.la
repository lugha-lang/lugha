// pauses: the longest stop in steady work, under either memory model.
// 256 trees stay alive and each round replaces one, so every round
// builds, reads and drops the same amount. A round normally takes well
// under a millisecond; one the clock sees take 2 ms or more was stopped by
// memory management: the collector marking what is alive, or reference
// counting freeing a large structure at once.
//
// lughac run bench/measure/pauses.la 20000          (the collector)
// LUGHA_MEMORY=rc lughac run bench/measure/pauses.la 20000

enum Tree {
    Leaf,
    Node(Tree, Tree),
}

fun make(depth: i64): Tree = if depth == 0 {
    Tree.Node(Tree.Leaf, Tree.Leaf)
} else {
    Tree.Node(make(depth - 1), make(depth - 1))
};

fun check(t: Tree): i64 = match t {
    .Leaf => 0,
    .Node(l, r) => 1 + check(l) + check(r),
};

fun main(args: string[], console: Console, clock: Clock) {
    let rounds = parse_i64(args[1]).unwrap();
    let mut forest: Tree[] = [];
    for _ in 0..256 {
        forest.push(make(10));
    }
    let mut longest = 0;
    let mut slow = 0;
    let mut sum = 0;
    let mut last = clock.monotonic_ms();
    for i in 0..rounds {
        forest[i % 256] = make(10);
        sum += check(forest[(i + 128) % 256]);
        let now = clock.monotonic_ms();
        let took = now - last;
        if took > longest {
            longest = took;
        }
        if took >= 2 {
            slow += 1;
        }
        last = now;
    }
    console.println("checked {sum} nodes");
    console.println("longest round: {longest} ms; rounds of 2 ms or more: {slow} of {rounds}");
}
