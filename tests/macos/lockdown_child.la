// Run on a Mac by CI: holding `Proc` but not `Net`, a started program
// can't connect, bind or send to an address (an internet socket's or a
// named UNIX socket's) and still passes a byte through an unnamed pair.
fun perl(proc: Proc, script: string): string = match proc.run("perl", ["-MSocket", "-e", script]) {
    .Ok(o) => "{o.code} {o.stdout}",
    .Err(e) => "err {e}",
};

fun main(console: Console, proc: Proc) {
    let at = "pack_sockaddr_in(9, inet_aton('127.0.0.1'))";
    console.println(
        perl(
            proc,
            "my $s; socket($s, PF_INET, SOCK_STREAM, 0) && connect($s, {at}) ? exit 0 : exit 3",
        ),
    );
    console.println(
        perl(
            proc,
            "my $s; socket($s, PF_INET, SOCK_STREAM, 0) && bind($s, {at}) ? exit 0 : exit 3",
        ),
    );
    console.println(
        perl(
            proc,
            "my $s; socket($s, PF_INET, SOCK_DGRAM, 0) && send($s, 'x', 0, {at}) ? exit 0 : exit 3",
        ),
    );
    console.println(
        perl(
            proc,
            "my $s; socket($s, PF_UNIX, SOCK_DGRAM, 0) && connect($s, pack_sockaddr_un('/var/run/syslog')) ? exit 0 : exit 3",
        ),
    );
    console.println(
        perl(
            proc,
            "socketpair(my $a, my $b, AF_UNIX, SOCK_STREAM, 0) or exit 4; syswrite($a, 'x'); sysread($b, my $c, 1); print $c",
        ),
    );
}
