// Run on Windows by CI, and under Wine by tests/windows.rs: the machine's
// interfaces, the loopback one among them.
fun main(console: Console, net: Net) {
    let all = net.interfaces().unwrap();
    console.println(all.any(fun(i) = i.up && i.addresses.any(fun(a) = a == "127.0.0.1")));
    console.println(all.all(fun(i) = i.index > 0 && i.name.len > 0));
}
