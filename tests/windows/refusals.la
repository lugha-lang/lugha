// What isn't built for Windows yet fails closed, with its reason.
fun main(console: Console, fs: Fs, net: Net, proc: Proc) {
    match fs.dir("C:\\") {
        .Ok(_) => console.println("?"),
        .Err(e) => console.println(e),
    }
    match net.connect("127.0.0.1:9") {
        .Ok(_) => console.println("?"),
        .Err(e) => console.println(e),
    }
    match proc.run("cmd", ["/c", "echo"]) {
        .Ok(_) => console.println("?"),
        .Err(e) => console.println(e),
    }
}
