// A float's raw bits and back.
fun main(console: Console) {
    let x = 1.5;
    let b = x.to_bits();
    console.println("{b:x}");
    console.println(f64.from_bits(b));
    console.println("{(-0.0).to_bits():x}");
    console.println(f64.from_bits(0x7FF0000000000000));
    console.println(f64.from_bits(0x7FF8000000000000).to_bits() == 0x7FF8000000000000);
    let h: f32 = 0.1;
    console.println("{h.to_bits():x}");
    console.println(f32.from_bits(h.to_bits()) == h);
    let n = f32.from_bits(0x7FC00000);
    console.println(n != n);
    console.println("{(1.0 as f32).to_bits():x}");
}
