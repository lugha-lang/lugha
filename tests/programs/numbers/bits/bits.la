// The bits example program.

fun main(console: Console) {
    let flags: u32 = 0b1010;
    console.println(flags & 0b0010 == 0b0010);
    console.println(flags | 1);
    console.println(flags ^ 0xf);
    console.println(~flags & 0xf);
    console.println(1 << 10);
    console.println(-8 >> 1);
    let mut m: u64 = 0xff;
    m <<= 8;
    console.println(m);
}
