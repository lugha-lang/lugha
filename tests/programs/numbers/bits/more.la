// Bit operators at every integer width.

fun main(console: Console) {
    let a: u8 = 0b1100_1010;
    console.println(a & 0x0f);
    console.println(a | 1);
    console.println(a ^ 0xff);
    console.println(~a);
    console.println(a >> 4);
    console.println(a << 7);

    let b: i32 = -16;
    console.println(b >> 2);
    console.println(b << 1);
    console.println(~b);

    let c: u32 = 0xdead_beef;
    console.println(c >> 16);
    console.println(c & 0xffff);
    console.println(1 << 31 as u32);

    let d: i64 = 1;
    console.println(d << 63);
    console.println((d << 63) >> 63);

    let e: u64 = 0xff00_ff00_ff00_ff00;
    console.println(e >> 8);
    console.println(~e);

    // compound assignments
    let mut f: u32 = 0b1;
    f <<= 4;
    f |= 0b11;
    f &= 0b10010;
    f ^= 0b1;
    f >>= 1;
    console.println(f);

    // precedence: shifts above &, & above ^, ^ above |, all above ==
    console.println(1 + 2 << 3);
    console.println(6 & 3 ^ 1 | 8);
    console.println(5 & 4 == 4);
}
