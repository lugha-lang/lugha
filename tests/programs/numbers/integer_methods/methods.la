// Methods on integers: wrapping arithmetic and bit counts.

fun main(console: Console) {
    let a: u8 = 250;
    console.println(a.wrapping_add(10));
    console.println(a.wrapping_mul(2));
    let zero: u8 = 0;
    console.println(zero.wrapping_sub(1));

    let b: i32 = 2147483647;
    console.println(b.wrapping_add(1));
    let lo: i64 = -9223372036854775807 - 1;
    console.println(lo.wrapping_sub(1));

    let c: u32 = 0;
    console.println("{c.count_ones()} {c.leading_zeros()} {c.trailing_zeros()}");
    let d: u64 = 18446744073709551615;
    console.println("{d.count_ones()} {d.leading_zeros()} {d.trailing_zeros()}");
    let e: i64 = -1;
    console.println("{e.count_ones()} {e.leading_zeros()}");
    let f: i32 = 1 << 20;
    console.println("{f.trailing_zeros()} {f.leading_zeros()}");
    console.println((5).count_ones());
    let g: u64 = 3;
    console.println(g.wrapping_mul(6148914691236517206));
}
