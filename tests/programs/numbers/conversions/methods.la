// Every conversion method at its edges, and the casts `as` still makes.
fun main(console: Console) {
    let small: u8 = 200;
    let wide = small as i64;
    let f = small as f64;
    console.println(wide);
    console.println(f);
    let big: i64 = 300;
    console.println(big.truncate<u8>());
    console.println(big.saturate<u8>());
    console.println(big.try_into<u8>().debug());
    console.println(big.try_into<u16>().debug());
    console.println(2.5.round<i64>());
    console.println((-2.5).round<i64>());
    console.println((-2.5).floor<i64>());
    console.println(2.1.ceil<i64>());
    console.println(9_007_199_254_740_993.round<f64>());
    console.println((-1).truncate<u8>());
    console.println((-1).saturate<u8>());
    console.println((-1).try_into<u64>().debug());
    console.println(u64.MAX.try_into<i64>().debug());
    console.println(i64.MAX.try_into<f64>().debug());
    console.println(1.5.try_into<i64>().debug());
    console.println(3.0.try_into<u8>().debug());
    console.println(1.0e300.saturate<i64>());
    console.println(1.0e300.saturate<f32>());
    console.println(0.1.try_into<f32>().debug());
    console.println(65.try_into<char>().debug());
    console.println(55296.try_into<char>().debug());
    let x: f64 = 0.0 / 0.0;
    console.println(x.saturate<i32>());
    console.println(x.try_into<f32>().debug());
    let c = 'é';
    console.println(c as u32);
    console.println(233.truncate<u8>() as char);
}
