// The more-numbers example program.

fun main(console: Console) {
    let big: u64 = 18446744073709551615;
    console.println(big);
    let n: u32 = 4000000000;
    console.println(n + 1);
    let x: f32 = 0.1;
    console.println(x);
    console.println(x as f64 > 0.1);
    console.println((-1).truncate<u32>());
}
