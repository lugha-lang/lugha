// Invalid bytes from read_line decoded as U+FFFD, `as char` at the edges,
// char_from, Latin-1 classification and case, format padding (in bytes),
// a char in a struct, and comparing chars.

struct Glyph { c: char, n: i64 }

fun main(console: Console) {
    match console.read_line() {
        .Some(line) => console.println(line.chars().collect().debug()),
        .None => console.println("none"),
    }
    console.println((-1).try_into<char>().unwrap_or('\u{FFFD}'));
    console.println(1114111.try_into<char>().unwrap_or('\u{FFFD}') as u32);
    console.println(1114112.try_into<char>().unwrap_or('\u{FFFD}') as u32);
    console.println(57343.try_into<char>().unwrap_or('\u{FFFD}') as u32);
    console.println(char_from(57344).is_some());
    console.println([
        'ß'.is_lower(),
        'ß'.to_upper() == 'ß',
        'ÿ'.to_upper() == 'ÿ',
        '7'.is_digit(),
        '\t'.is_whitespace(),
        'Ä'.to_lower() == 'ä',
        '×'.is_alphabetic(),
    ].debug());
    console.println("[{'x':<3}][{'é':^5}]");
    console.println((Glyph { c: 'x', n: 1 }).debug());
    let c = 'q';
    if c == 'q' {
        console.println("quit");
    }
}
