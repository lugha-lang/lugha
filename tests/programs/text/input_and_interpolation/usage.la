fun main(args: string[], console: Console) {
    let a = args;
    if a.len < 2 {
        console.println("usage: prog <n>");
        return;
    }
    match parse_i64(a[1]) {
        .Some(n) => console.println("{n} doubled is {n * 2}"),
        .None => console.println("usage: prog <n>"),
    }
}
