fun show_i(console: Console, s: string) {
    match parse_i64(s) {
        .Some(n) => console.println("i64 {s} -> {n}"),
        .None => console.println("i64 {s} -> none"),
    }
}

fun show_f(console: Console, s: string) {
    match parse_f64(s) {
        .Some(x) => console.println("f64 {s} -> {x}"),
        .None => console.println("f64 {s} -> none"),
    }
}

fun main(console: Console) {
    for s of ["42", "-7", "9223372036854775807", "-9223372036854775808", "", "+1", "1_0", "0x1", "9223372036854775808", " 1", "-"] {
        show_i(console, s);
    }
    for s of ["2.5", "-1e3", "3", "1.5E-2", ".5", "5.", "nan", "1e", "inf", " 2"] {
        show_f(console, s);
    }
}
