// String literals and interpolations inside `{…}`.

fun label(ok: bool): string = "{if ok { "yes" } else { "no" }}";

fun main(console: Console) {
    let parts = ["a", "b", "c"];
    console.println("<{parts.join("-")}>");
    console.println("{label(true)} / {label(false)}");
    let name = "ratio";
    let a = 3;
    let b = 4;
    console.println("{name}: {"{a}/{b}"}");
    // Two levels deep, with escapes and doubled braces in the nested parts.
    console.println("[{"({"\"{a + b}\""})"}]");
    console.println("{"{{literal}}"} {"tab\tend"}");
    console.println("{parts.join(", ")}");
}
