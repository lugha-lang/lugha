// Format widths count characters, not bytes, and any
// character can fill.
fun main(console: Console) {
    let n = "Zoë";
    console.println("[{n:<6}]");
    console.println("[{n:>6}]");
    console.println("[{n:^7}]");
    let j = "日本";
    console.println("[{j:<4}]");
    let e = "😀";
    console.println("[{e:>3}]");
    console.println("[{n:é^9}]");
    console.println("[{n:<2}]");
    let c = 'ñ';
    console.println("[{c:>3}]");
    console.println(format("[{:*<5}]", "añb"));
    let k = 42;
    console.println("[{k:é>5}]");
    let o = Some("é");
    console.println("[{o.debug():<12}]");
}
