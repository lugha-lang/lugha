fun main(console: Console) {
    let mut total = 0;
    let mut bad: string[] = [];
    let mut lines = 0;
    while true {
        match console.read_line() {
            .Ok(.Some(line)) => {
                lines += 1;
                match parse_i64(line.trim()) {
                    .Some(n) => { total += n; }
                    .None => { bad.push(line); }
                }
            }
            .Ok(.None) => { break; }
            .Err(e) => { console.eprintln(e); break; }
        }
    }
    console.println("{lines} lines, total {total}");
    console.println("bad: " + bad.join("|"));
}
