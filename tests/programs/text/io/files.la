fun save(fs: Fs, path: string, lines: string[]): Result<i64, string> {
    let mut total = fs.cwd().write_file(path, "")?;
    for line of lines {
        total += fs.cwd().append_file(path, line + "\n")?;
    }
    Ok(total)
}

fun count_lines(fs: Fs, path: string): Result<i64, string> {
    let text = fs.cwd().read_file(path)?;
    Ok(text.lines().len)
}

fun main(console: Console, fs: Fs) {
    match save(fs, "notes.txt", ["one", "two", "three"]) {
        .Ok(n) => console.println("saved {n} bytes"),
        .Err(e) => console.println("save failed: " + e),
    }
    match count_lines(fs, "notes.txt") {
        .Ok(n) => console.println("{n} lines"),
        .Err(e) => console.println("read failed: " + e),
    }
    match fs.cwd().write_file("notes.txt", "replaced") {
        .Ok(n) => console.println("wrote {n}"),
        .Err(e) => console.println(e),
    }
    match fs.cwd().read_file("notes.txt") {
        .Ok(t) => console.println(t),
        .Err(e) => console.println(e),
    }
    match fs.cwd().read_file("missing.txt") {
        .Ok(_) => console.println("unexpected"),
        .Err(e) => console.println("missing.txt: " + e),
    }
    match count_lines(fs, "missing.txt") {
        .Ok(_) => console.println("unexpected"),
        .Err(e) => console.println("count: " + e),
    }
}
