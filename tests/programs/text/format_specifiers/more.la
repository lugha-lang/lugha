// Every alignment and fill, zero padding with signs and prefixes, the
// integer kinds at several widths, f32 precision, a padded struct, text
// longer than its width, and specifiers in nested interpolations.

struct P { x: i64 }

fun main(console: Console) {
    let n = 7;
    console.println("[{n:<4}][{n:^5}][{n:>4}][{n:_<4}][{n:.^5}]");
    console.println("{-7:06} {255:#06x} {255:08b} {255:#o}");
    let big: u16 = 48879;
    console.println("{big:X} {big:#x} {u64.MAX:x}");
    let small: i8 = -2;
    console.println("{small:x} {small:b}");
    let f: f32 = 2.5;
    console.println("{f:.3} {1.0 / 3.0:.4} {-1.5:08.2}");
    console.println("{2.5:>8}|");
    console.println("[{(P { x: 1 }).debug():>12}]");
    console.println("[{"toolong":3}]");
    let inner = "{n:03}";
    console.println("<{inner:>6}>");
    console.println("{"a":-^1}{"b":>2}");
    console.println("{7:>05}|");
}
