// Printing needs `Display`: an array, an `Option`, `()` and a struct
// without `impl Display` have none, and their help names `.debug()`.
struct P { x: i64 }

fun nothing() {}

fun main(console: Console) {
    console.println([1, 2]);
    let o: Option<i64> = None;
    let t = "found {o}";
    let s = to_string(P { x: 1 });
    console.eprintln(nothing());
}
