struct Point { x: i64, y: i64 }

impl Display for Point {
    fun show(self): string = "({self.x}, {self.y})";
}

enum Shape { Dot, Circle(f64) }

fun main(console: Console) {
    let p = Point { x: 1, y: 2 };
    console.println(p);                                  // (1, 2)
    console.println("at {p}");                           // at (1, 2)
    console.println(p.debug());                          // Point { x: 1, y: 2 }
    console.println([p, p].debug());                     // [Point { x: 1, y: 2 }, Point { x: 1, y: 2 }]
    console.println(Some("ada").debug());                // Some("ada")
    console.println(Shape.Circle(1.5).debug());          // Circle(1.5)
    console.println("ada".debug());                      // "ada"
    let q = debug(p.x + 1);                      // stderr: [main.la:16] p.x + 1 = 2
    console.println(q);                                  // 2
}
