// A panicking actor unwinds its handler, running its defers; its scope
// reports the panic, and the program goes on.

actor Worker {
    done: i64,
    fun run(self, console: Console, fail: bool) {
        defer console.println("handler cleaned up");
        let names = ["a" + "b"];
        if fail {
            panic("worker failed with {names.len} name");
        }
        console.println("worked");
    }
}

fun main(console: Console) {
    let r = scope s {
        let w = s.spawn(Worker { done: 0 });
        w.run(console, false);
        w.run(console, true);
    };
    match r {
        .Ok(_) => console.println("finished"),
        .Err(f) => console.println("ended after: {f}"),
    }
    console.println("main goes on");
}
