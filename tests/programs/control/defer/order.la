// `defer`: several run last first, at the end of
// their own block, reading values as they are when they run.
fun main(console: Console) {
    defer console.println("c");
    {
        defer console.println("inner end");
        console.println("inner");
    }
    defer {
        console.println("b");
    }
    let mut n = 1;
    defer console.println("n = {n}");
    n = 2;
    let n = 10;
    console.println("a {n}");
}
