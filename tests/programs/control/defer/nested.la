// A `defer` inside a deferred block runs at that block's end; a closure's
// and a spawned call's defers run when they return.
fun work(console: Console, n: i64): i64 {
    defer console.println("task {n} done");
    n * 2
}

fun main(console: Console, root: Scope) {
    defer {
        defer console.println("outer last");
        console.println("outer first");
    }
    let f = fun(x: i64): i64 {
        defer console.println("closure done");
        x + 1
    };
    console.println(f(1));
    let t = root.spawn(work(console, 21));
    console.println(t.join().unwrap());
    defer {
        let mut i = 0;
        while true {
            i += 1;
            if i == 3 {
                break;
            }
        }
        console.println("looped {i}");
    }
}
