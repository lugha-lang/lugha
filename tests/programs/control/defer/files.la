// The point of `defer`: a file opened in a loop is closed on every exit,
// even when a read fails and `?` returns early, so descriptors stay flat.

fun first_line(files: Fs, path: string): Result<string, string> {
    let f = files.cwd().open(path)?;
    defer f.close();
    match f.read_line()? {
        .Some(line) => Ok(line),
        .None => Ok(""),
    }
}

fun open_count(files: Fs): i64 {
    match files.cwd().list("/proc/self/fd") {
        .Ok(names) => names.len,
        .Err(e) => panic(e),
    }
}

fun main(console: Console, files: Fs) {
    let before = open_count(files);
    let mut failed = 0;
    for i in 0..10000 {
        // A folder opens, but reading it fails.
        if first_line(files, ".").is_err() {
            failed += 1;
        }
    }
    console.println(failed);
    console.println(open_count(files) == before);
}
