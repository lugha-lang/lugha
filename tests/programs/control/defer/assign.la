// `defer` takes an assignment too, run at exit like any other.
fun count(): i64 {
    let mut total = 0;
    for i in 0..10 {
        defer total += i;
        if i == 3 {
            break;
        }
    }
    total
}

fun main(console: Console) {
    let mut n = 1;
    defer console.println(n);
    defer n += 10;
    let mut log: string[] = ["a"];
    defer log = [];
    console.println(n);
    console.println(count());
}
