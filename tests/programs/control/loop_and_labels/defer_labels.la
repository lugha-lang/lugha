// A labelled exit runs the defers of every block it leaves, innermost first.
fun main(console: Console) {
    outer: for i in 0..3 {
        defer console.println("outer {i} done");
        for j in 0..3 {
            defer console.println("inner {i}{j} done");
            if j == 1 {
                continue outer;
            }
            if i == 2 {
                break outer;
            }
        }
    }
    console.println("after");
    let v = l: loop {
        defer console.println("leaving the loop");
        break l 7;
    };
    console.println(v);
}
