// A `loop` that never waits is preempted like any other loop, so the
// task that ends it runs.
fun spin(stop: Chan<bool>): i64 {
    let mut turns = 0;
    loop {
        if stop.try_recv().is_some() {
            break 1;
        }
        turns += 1;
    }
}

fun main(console: Console, root: Scope) {
    let stop: Chan<bool> = Chan.buffered(1);
    let s = root.spawn(spin(stop));
    root.spawn(fun() {
        stop.send(true);
    }());
    console.println(s.join().unwrap());
}
