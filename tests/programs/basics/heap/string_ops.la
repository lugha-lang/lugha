// Strings: concatenation, comparison by content, byte length and bytes.
fun greet(name: string): string = "hello, " + name + "!";

fun main(console: Console) {
    let g = greet("lugha");
    console.println(g);
    console.println(g == "hello, lugha!");
    console.println(g != "hello, lugha!");
    console.println("abc" == "abd");
    console.println(g.len);
    console.println("é👋".len);
    console.println(g[0]);
    let s = "abc";
    let mut sum: i64 = 0;
    for i in 0..s.len {
        sum += s[i] as i64;
    }
    console.println(sum);
}
