/* Block comments: anywhere whitespace may be,
   over several lines, and nested. */

/** A doc-style comment is an ordinary block comment to the compiler. */
fun add(a: i64, /* the other */ b: i64): i64 = a + b;

fun main(console: Console) {
    let x = 1 /* inline */ + 2;
    /* commented out:
    println("old");   /* a comment inside */
    println(x * 100);
    */
    console.println(x);                       // 3
    console.println(add(x, 4));               // 7
    console.println("/* not a comment */");   // text inside a string
    console.println("{x /* in a hole */ + 1}");
    /*/ odd but closed */ console.println("done");
}
