// An actor: casts are queued, calls wait for the reply, and a panic ends
// the actor and fails its scope, which reports it.
public actor Counter {
    count: i64,
    fun new(start: i64): Counter = Counter { count: start };
    fun add(mut self, n: i64) { self.count += n; }
    fun get(self): i64 = self.count;
    fun divide(mut self, by: i64) { self.count = self.count / by; }
}

fun main(console: Console) {
    let r = scope s {
        let c = s.spawn(Counter.new(10));
        c.add(5);
        console.println(c.get());
        c.divide(0);
    };
    match r {
        .Ok(_) => console.println("?"),
        .Err(f) => console.println("{f.task} failed"),
    }
    let r = scope s {
        let d = s.spawn(Counter { count: 0 });
        d.stop();
        d.debug()
    };
    console.println(r.debug());
}
