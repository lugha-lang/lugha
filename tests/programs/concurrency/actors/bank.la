// One account actor, many green threads depositing: the actor handles
// one message at a time, so no deposit is lost.
actor Account {
    balance: i64,
    fun deposit(mut self, amount: i64) { self.balance += amount; }
    fun total(self): i64 = self.balance;
}

fun customer(account: Account, times: i64) {
    for i in 0..times {
        account.deposit(1);
    }
}

fun main(console: Console, root: Scope) {
    let account = root.spawn(Account { balance: 0 });
    let deposits = scope s {
        for c in 0..10 {
            s.spawn(customer(account, 100));
        }
    };
    console.println("{account.total()} {deposits.is_ok()}");
}
