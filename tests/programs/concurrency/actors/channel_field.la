// A channel may cross into an actor: it is messaging too.
actor Echo {
    out: Sender<string>,
    fun say(self, text: string) {
        self.out.send("echo: {text}");
    }
}

fun main(console: Console) {
    let (out, lines) = Chan<string>.new(4);
    let r = scope s {
        let e = s.spawn(Echo { out: out });
        e.say("hi");
        e.say("there");
    };
    out.close();
    while let .Some(line) = lines.recv() {
        console.println(line);
    }
}
