// A hand-written supervisor: `join` says whether the worker crashed, so it
// starts a new one until the work is done.
actor Worker {
    attempt: i64,
    fun run(self, console: Console) {
        if self.attempt < 3 {
            panic("attempt {self.attempt} failed");
        }
        console.println("attempt {self.attempt} succeeded");
    }
}

fun main(console: Console) {
    let mut attempt = 1;
    while true {
        let w = spawn Worker { attempt: attempt };
        w.run(console);
        w.stop();
        match w.join() {
            .None => {
                break;
            }
            .Some(why) => console.println("restarting after: {why}"),
        }
        attempt += 1;
    }
    console.println("done after {attempt} attempts");
}
