// A hand-written supervisor: each attempt runs in a scope of its own,
// whose failure says the worker crashed, so it starts a new one until the
// work is done.
actor Worker {
    attempt: i64,
    fun run(self, console: Console) {
        if self.attempt < 3 {
            panic("attempt {self.attempt} failed");
        }
        console.println("attempt {self.attempt} succeeded");
    }
}

fun main(console: Console) {
    let mut attempt = 1;
    loop {
        let tried = scope s {
            let w = s.spawn(Worker { attempt: attempt });
            w.run(console);
        };
        match tried {
            .Ok(_) => {
                break;
            }
            .Err(f) => match f.kind {
                .Panic(why) => console.println("restarting after: {why}"),
                _ => console.println("restarting"),
            },
        }
        attempt += 1;
    }
    console.println("done after {attempt} attempts");
}
