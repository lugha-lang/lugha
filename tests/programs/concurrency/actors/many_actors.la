// A thousand actors, each with its own green thread and mailbox.
actor Cell {
    value: i64,
    fun double(self): i64 = self.value * 2;
}

fun main(console: Console, root: Scope) {
    let mut cells: Cell[] = [];
    for i in 0..1000 {
        cells.push(root.spawn(Cell { value: i }));
    }
    let mut sum = 0;
    for c of cells {
        sum += c.double();
    }
    console.println(sum);
}
