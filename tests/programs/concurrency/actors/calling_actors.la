// Actors hold other actors' handles and message them.
actor Logger {
    lines: string[],
    fun log(mut self, line: string) { self.lines.push(line); }
    fun dump(self): string[] = self.lines;
}

actor Worker {
    log: Logger,
    done: i64,
    fun work(mut self, job: string): i64 {
        self.log.log("working on {job}");
        self.done += 1;
        self.done
    }
}

fun main(console: Console, root: Scope) {
    let log = root.spawn(Logger { lines: [] });
    let w = root.spawn(Worker { log: log, done: 0 });
    console.println(w.work("a"));
    console.println(w.work("b"));
    for line of log.dump() {
        console.println(line);
    }
}
