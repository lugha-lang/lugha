// A scope's value: `Ok` with its body's, once every task it started is done.
fun square(n: i64): i64 = n * n;

fun main(console: Console) {
    let r = scope s {
        let a = s.spawn(square(3));
        let b = s.spawn(square(4));
        a.join().unwrap() + b.join().unwrap()
    };
    console.println(r.debug());
    // `scope` is a name everywhere else.
    let scope = 7;
    console.println(scope);
}
