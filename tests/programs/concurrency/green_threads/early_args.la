// The arguments are evaluated at once, by the spawning thread.
fun next(console: Console, label: string): i64 {
    console.println("evaluating {label}");
    1
}

fun show(console: Console, n: i64, m: i64) {
    console.println("running with {n} {m}");
}

fun main(console: Console, root: Scope) {
    let t = root.spawn(show(console, next(console, "first"), next(console, "second")));
    console.println("spawned");
    t.join().unwrap();
}
