// `select` picks a ready arm, sends, times out, or takes `default`.
import std.task;

fun later(c: Sender<string>, ms: i64, text: string) {
    task.sleep(ms);
    c.send(text);
}

fun main(console: Console, root: Scope) {
    let (to_a, a) = Chan<string>.new(0);
    let (b, from_b) = Chan<i64>.new(1);
    // Nothing is ready: `default`.
    let first = select {
        m = a.recv() => "a",
        default => "nothing ready",
    };
    console.println(first);
    // `b` has room: the send arm runs.
    select {
        b.send(7) => console.println("sent 7"),
        m = a.recv() => console.println("unexpected"),
    }
    console.println(from_b.try_recv().debug());
    // Nobody sends in time: `after`.
    select {
        m = a.recv() => console.println("unexpected"),
        after(20) => console.println("timed out"),
    }
    // A sender arrives while waiting.
    root.spawn(later(to_a, 5, "late hello"));
    select {
        m = a.recv() => match m {
            .Some(text) => console.println(text),
            .None => console.println("closed"),
        },
        after(2000) => console.println("too slow"),
    }
    // A closed channel's arm fires with `None`.
    to_a.close();
    select {
        m = a.recv() => console.println("closed gives {m.debug()}"),
    }
}
