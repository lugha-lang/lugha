// A busy loop that never waits is preempted, so the thread that ends it runs.
fun spin(stop: Ref<bool>): i64 {
    let mut turns = 0;
    while !stop.get() {
        turns += 1;
    }
    1
}

fun main(console: Console, root: Scope) {
    let stop = Ref.new(false);
    let s = root.spawn(spin(stop));
    root.spawn(fun() { stop.set(true); }());
    console.println(s.join().unwrap());
}
