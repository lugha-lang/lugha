// An unbuffered channel hands each value over: `send` waits for `recv`.
fun ponger(console: Console, pings: Chan<i64>, pongs: Chan<i64>) {
    while let .Some(n) = pings.recv() {
        console.println("pong {n}");
        pongs.send(n + 1);
    }
    console.println("ponger done");
}

fun main(console: Console) {
    let pings: Chan<i64> = Chan.new();
    let pongs: Chan<i64> = Chan.new();
    let t = spawn ponger(console, pings, pongs);
    let mut n = 0;
    for i in 0..3 {
        console.println("ping {n}");
        pings.send(n);
        n = pongs.recv().unwrap();
    }
    pings.close();
    t.join();
    console.println(n);
}
