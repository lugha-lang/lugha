// An unbuffered channel hands each value over: `send` waits for `recv`.
fun ponger(console: Console, pings: Receiver<i64>, pongs: Sender<i64>) {
    while let .Some(n) = pings.recv() {
        console.println("pong {n}");
        pongs.send(n + 1);
    }
    console.println("ponger done");
}

fun main(console: Console, root: Scope) {
    let (ping, pings) = Chan<i64>.new(0);
    let (pong, pongs) = Chan<i64>.new(0);
    let t = root.spawn(ponger(console, pings, pong));
    let mut n = 0;
    for i in 0..3 {
        console.println("ping {n}");
        ping.send(n);
        n = pongs.recv().unwrap();
    }
    ping.close();
    t.join().unwrap();
    console.println(n);
}
