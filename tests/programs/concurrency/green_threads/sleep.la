// Sleepers wake in deadline order; the others run meanwhile.
import std.task;

fun nap(console: Console, ms: i64) {
    task.sleep(ms);
    console.println("woke after {ms}");
}

fun main(console: Console, root: Scope) {
    let a = root.spawn(nap(console, 30));
    let b = root.spawn(nap(console, 10));
    let c = root.spawn(nap(console, 20));
    a.join().unwrap();
    b.join().unwrap();
    c.join().unwrap();
}
