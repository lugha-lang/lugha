// Sleepers wake in deadline order; the others run meanwhile.
import std.task;

fun nap(console: Console, ms: i64) {
    task.sleep(ms);
    console.println("woke after {ms}");
}

fun main(console: Console) {
    let a = spawn nap(console, 30);
    let b = spawn nap(console, 10);
    let c = spawn nap(console, 20);
    a.join();
    b.join();
    c.join();
}
