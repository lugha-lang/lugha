// Values cross a channel as copies: changing the original later changes
// nothing the receiver got. Tasks and channels print as what they are.
struct Point {
    x: i64,
    y: i64,
}

fun main(console: Console, root: Scope) {
    let (c, r) = Chan<i64[]>.new(1);
    let mut xs = [1, 2, 3];
    c.send(xs);
    xs[0] = 100;
    console.println(r.recv().unwrap().debug());
    console.println(xs.debug());
    let (p, points) = Chan<Point>.new(1);
    p.send(Point { x: 1, y: 2 });
    let got = points.recv().unwrap();
    console.println("{got.x} {got.y}");
    let t = root.spawn(fun(): Point {
        Point { x: 3, y: 4 }
    }());
    let q = t.join().unwrap();
    console.println("{q.x} {q.y}");
    console.println(t.debug());
    console.println(c.debug());
    console.println(c.is(c));
}
