// `yield_now` lets every ready thread run first: turns alternate.
import std.task;

fun say(console: Console, name: string) {
    for i in 0..3 {
        console.println("{name}{i}");
        task.yield_now();
    }
}

fun main(console: Console) {
    let a = spawn say(console, "a");
    let b = spawn say(console, "b");
    a.join();
    b.join();
}
