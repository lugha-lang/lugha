// Go's `go func() { … }()`: a closure literal called on the spot. What the
// closures count crosses back through a channel.
fun main(console: Console, root: Scope) {
    let k = 2;
    let counted: Chan<i64> = Chan.buffered(2);
    let t = root.spawn(fun(): i64 {
        counted.send(1);
        k * 10
    }());
    let u = root.spawn(fun() {
        counted.send(1);
    }());
    console.println(t.join().unwrap());
    u.join().unwrap();
    counted.close();
    let mut total = 0;
    while let .Some(n) = counted.recv() {
        total += n;
    }
    console.println(total);
}
