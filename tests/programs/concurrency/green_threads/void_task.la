// A call that returns nothing gives a plain `Task`.
fun greet(console: Console, name: string) {
    console.println("hello, {name}");
}

fun main(console: Console, root: Scope) {
    let t: Task = root.spawn(greet(console, "green thread"));
    console.println("spawned");
    t.join().unwrap();
    console.println("joined");
}
