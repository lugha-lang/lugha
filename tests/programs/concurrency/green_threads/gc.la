// Many threads allocate; arrays kept only on suspended stacks survive.
import std.task;

fun build(seed: i64): i64 {
    let mut kept: i64[] = [];
    for i in 0..1000 {
        kept.push(seed + i);
        if i % 100 == 0 {
            task.yield_now();
        }
        let junk = [i; 64];
    }
    let mut sum = 0;
    for v of kept {
        sum += v;
    }
    sum
}

fun add_build(seed: i64, sums: Sender<i64>) {
    sums.send(build(seed));
}

fun main(console: Console) {
    let (sums, results) = Chan<i64>.new(50);
    let built = scope s {
        for seed in 0..50 {
            s.spawn(add_build(seed, sums));
        }
    };
    sums.close();
    let mut total = 0;
    while let .Some(n) = results.recv() {
        total += n;
    }
    console.println("{total} {built.is_ok()}");
}
