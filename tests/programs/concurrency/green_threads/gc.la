// Many threads allocate; arrays kept only on suspended stacks survive.
import std.task;

fun build(seed: i64): i64 {
    let mut kept: i64[] = [];
    for i in 0..1000 {
        kept.push(seed + i);
        if i % 100 == 0 {
            task.yield_now();
        }
        let junk = [i; 64];
    }
    let mut sum = 0;
    for v of kept {
        sum += v;
    }
    sum
}

fun add_build(seed: i64, total: Ref<i64>) {
    let sum = build(seed);
    total.update(fun(n: i64): i64 = n + sum);
}

fun main(console: Console) {
    let total = Ref.new(0);
    let built = scope s {
        for seed in 0..50 {
            s.spawn(add_build(seed, total));
        }
    };
    console.println("{total.get()} {built.is_ok()}");
}
