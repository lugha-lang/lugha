// When `main` returns, the program waits for the root scope's tasks.
import std.task;

fun later(console: Console) {
    for i in 0..3 {
        task.yield_now();
    }
    console.println("task done");
}

fun main(console: Console, root: Scope) {
    root.spawn(later(console));
    console.println("main done");
}
