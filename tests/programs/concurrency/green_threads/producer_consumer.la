// A buffered channel: the producer runs ahead by up to two values, then
// closes the channel; the consumer drains it.
fun produce(console: Console, out: Chan<string>, count: i64) {
    for i in 0..count {
        out.send("item {i}");
        console.println("sent {i}");
    }
    out.close();
}

fun main(console: Console, root: Scope) {
    let c: Chan<string> = Chan.buffered(2);
    root.spawn(produce(console, c, 5));
    while let .Some(item) = c.recv() {
        console.println("got {item}");
    }
    console.println("closed: {c.recv().debug()}");
}
