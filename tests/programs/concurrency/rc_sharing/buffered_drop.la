// A channel dropped while values still wait in its buffer: they go with it.
fun fill(n: i64): (Sender<string[]>, Receiver<string[]>) {
    let (c, r) = Chan<string[]>.new(n);
    for i in 0..n {
        c.send(["value", "{i}"]);
    }
    (c, r)
}

fun main(console: Console) {
    let (c, r) = fill(4);
    console.println(r.recv().unwrap().debug());
    let (d, rd) = fill(3);
    d.close();
    console.println("dropped with values inside");
}
