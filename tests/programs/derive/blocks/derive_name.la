// `derive` stays an ordinary name in programs: `$derive` blocks are for
// lughac's own sources only.
import std.json;

struct Point { derive: i64, tuple: i64 } with json.Json

fun derive(x: i64): i64 = x * 2;

fun main(console: Console) {
    let p = Point { derive: 3, tuple: 4 };
    console.println(derive(p.derive));
    let tuple = p.tuple;
    console.println(tuple);
    console.println(json.stringify(json.encode(p)).unwrap());
}
