// A generic type derives conditionally: `Pair<X>` is JSON where `X` is,
// and `impl I for T = derive;` asks as `with` does.
import std.json;

struct Pair<T> { a: T, b: T } with json.Json

enum Light { Red, Green }

impl json.Json for Light = derive;

fun main() {
    println(json.stringify(json.encode(Pair { a: 1, b: 2 })).unwrap());
    println(json.stringify(json.encode(Pair { a: Light.Red, b: Light.Green })).unwrap());
    println(json.stringify(json.encode([(Light.Red, "stop")])).unwrap());
}
