// A type's own method named like one of `json.Json`'s items doesn't make
// it JSON: a type asks with `with json.Json` or implements it (E0422).
import std.json;

struct Point { x: i64, y: i64 }

impl Point {
    fun to_json(self): string = "({self.x}, {self.y})";
}

fun main() {
    let v = json.encode(Point { x: 1, y: 2 });
}
