// Hashing in Lugha: maps and sets keyed by every kind
// of `Eq` type find what they hold, and equal sets or maps built in
// different orders are one key.
extern "malloc" fun c_malloc(n: u64): CPtr;

struct P { x: i64, tag: string, at: (i8, u16) } with Key
enum Tree { Leaf(i64), Node(Tree, Tree), Empty } with Key

fun main(console: Console) {
    // The same numbers, the other way round: equal sets, one key.
    let mut sets: Set<Set<i64>> = Set {};
    for n in 0..200 {
        let mut a: Set<i64> = Set {};
        let mut b: Set<i64> = Set {};
        for i in 0..n {
            a.insert(i);
            b.insert(n - 1 - i);
        }
        sets.insert(a);
        sets.insert(b);
    }
    console.println(sets.len);

    let mut maps: Set<Map<string, i64>> = Set {};
    maps.insert(Map { "a": 1, "b": 2 });
    maps.insert(Map { "b": 2, "a": 1 });
    maps.insert(Map { "a": 1, "b": 3 });
    console.println(maps.len);

    let mut by_point: Map<P, i64> = Map {};
    by_point.insert(P { x: 1, tag: "a", at: (-1, 2) }, 10);
    by_point.insert(P { x: 1, tag: "b", at: (-1, 2) }, 20);
    console.println((by_point.get(P { x: 1, tag: "a", at: (-1, 2) })).debug());
    console.println((by_point.get(P { x: 1, tag: "a", at: (-1, 3) })).debug());

    let mut trees: Map<Tree, string> = Map {};
    trees.insert(Tree.Node(Tree.Leaf(1), Tree.Empty), "left");
    trees.insert(Tree.Node(Tree.Empty, Tree.Leaf(1)), "right");
    console.println((trees.get(Tree.Node(Tree.Leaf(1), Tree.Empty))).debug());
    console.println(trees.len);

    let mut small: Map<u8, char> = Map {};
    let mut wide: Map<i32, bool> = Map {};
    for i in 0..200 {
        small.insert(i.truncate<u8>(), 'x');
        wide.insert(-(i.truncate<i32>()), i % 2 == 0);
    }
    console.println("{small.len} {wide.get(-4).debug()} {wide.get(5).debug()}");

    let mut chars: Set<char> = Set { 'é', 'e' };
    chars.insert('é');
    let mut options: Set<Option<string>> = Set {};
    options.insert(None);
    options.insert(Some("x"));
    options.insert(None);
    let mut lists: Map<i64[], i64> = Map {};
    lists.insert([1, 2], 1);
    lists.insert([2, 1], 2);
    lists.insert([1, 2], 3);
    console.println("{chars.len} {options.len} {lists.len} {lists.get([1, 2]).debug()}");

    let p = c_malloc(8);
    let q = c_malloc(8);
    let mut handles: Map<CPtr, string> = Map {};
    handles.insert(p, "p");
    handles.insert(q, "q");
    handles.insert(p, "p again");
    console.println("{handles.len} {handles.get(p).debug()}");
}
