// Every callback says how C's call runs it; `spawned` needs `data` and no
// result.
extern fun on_tick(f: fun(i64, data), user: data);
extern fun sort(n: i64, cmp: fun(i64, i64): i32);
extern fun each(f: spawned fun(i64));
extern fun ask(f: spawned fun(i64, data): i64, user: data);

fun main() {}
