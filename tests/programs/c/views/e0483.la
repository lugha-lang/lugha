// A view never outlives the call it was given to.
struct Kept { v: View<u8> }
enum Held { One(View<u8>) }

fun back(v: View<u8>): View<u8> = v;
fun id<T>(x: T): T = x;

fun use_it(v: View<u8>) {
    let some = Some(v);
    let all = [v];
    let pair = (v, 1);
    let boxed = Ref.new(v);
    let f = fun(): u8 = v[0];
    let same = id(v);
    let (tx, rx) = Chan<View<u8>>.new(1);
}

fun main() {}
