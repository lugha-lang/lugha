   |
 4 | fun label(n: i64): string = "n = {n}";
   |                             ^^^^^^^^^
 5 | fun step(n: i64): i64 {
 6 |     let s = label(n);
   |             -------- `label` is called here, on the way from the callback
   .
11 |     on_tick(fun(n: i64) { let m = step(n); });
   |                                   ------- `step` is called here, on the way from the callback
