// Strings are values: bound, passed, returned, printed; `to_string` of each primitive.
fun greeting(name: string): string = name;

fun main(console: Console) {
    let s = "héllo 👋";
    let t: string = greeting(s);
    console.println(t);
    let n: i32 = 7;
    let u: u8 = 200;
    console.println(to_string(n));
    console.println(to_string(-3));
    console.println(to_string(u));
    console.println(to_string(2.5));
    console.println(to_string(true));
}
