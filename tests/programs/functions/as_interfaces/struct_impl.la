// A struct implements a function interface by hand: it's callable, and
// converts to the function type.
struct Scale { k: i64 }

impl fun(i64): i64 for Scale {
    fun call(self, x: i64): i64 = x * self.k;
}

fun apply(f: fun(i64): i64, x: i64): i64 = f(x);

fun twice<F: fun(i64): i64>(f: F, x: i64): i64 = f(f(x));

fun main(console: Console) {
    let s = Scale { k: 4 };
    console.println(s(2));
    console.println(apply(s, 3));
    console.println(twice(s, 1));
}
