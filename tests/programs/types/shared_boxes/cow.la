// Boxes with copy-on-write and loop ownership: arrays
// moving in and out of a box inside loops never change each other.
fun main(console: Console) {
    let r = Ref.new([1, 2, 3]);
    let mut a = r.get();
    for i in 0..3 {
        a[i] = 0;
    }
    console.println("{r.get().debug()} {a.debug()}");
    let mut b = [5, 5];
    for i in 0..2 {
        b[i] += 1;
        r.set(b);
    }
    b[0] = 100;
    console.println("{r.get().debug()} {b.debug()}");
    let s = r;
    let mut c = s.get();
    c.push(7);
    console.println("{r.get().debug()} {c.debug()}");
    let grid = Ref.new([[1, 2], [3, 4]]);
    let mut g = grid.get();
    g[1][0] = 9;
    grid.update(fun(old: i64[][]): i64[][] {
        let mut next = old;
        next[0][0] = 8;
        next
    });
    console.println("{grid.get().debug()} {g.debug()}");
}
