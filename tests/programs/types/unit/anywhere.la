// `()` in every position: keys, sets, closures, boxes, tuples, generics, order.
struct Wrap<T> {
    v: T,
    n: i64,
} with Eq

fun log(console: Console, s: string) {
    console.println(s);
}

fun pick<T>(a: T, b: T, first: bool): T = if first { a } else { b };

fun main(console: Console) {
    let m: Map<(), i64> = Map { (): 7 };
    console.println(m[()]);
    let s: Set<()> = Set { (), () };
    console.println(s.debug());
    let mut us: ()[] = [(), (), ()];
    us.push(());
    let popped = us.pop();
    console.println("{us.len} {popped.debug()}");
    let f = fun(): () = log(console, "closure");
    let r: () = f();
    console.println(r.debug());
    let units = [1, 2].map(fun(x: i64) {
        console.println(x);
    });
    console.println(units.debug());
    let b = Ref.new(());
    b.set(());
    console.println(b.get().debug());
    let t = ((), 1);
    console.println(t.debug());
    let (u, n) = t;
    console.println("{u.debug()} {n}");
    let w = Wrap { v: (), n: 2 };
    console.println(w == Wrap { v: (), n: 2 });
    console.println((pick((), (), true)).debug());
    let o: Option<()> = None;
    match o {
        .Some(_) => console.println("some"),
        .None => console.println("none"),
    }
    console.println(() < ());
    console.println(() <= ());
    more(console);
}

fun more(console: Console) {
    let mut xs = [(), ()];
    xs = xs.sort();
    console.println(xs.debug());
    console.println(((), 2) < ((), 3));
}
