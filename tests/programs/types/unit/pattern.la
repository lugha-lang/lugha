// `()` as a pattern.
fun log(console: Console, s: string) {
    console.println(s);
}

fun main(console: Console) {
    let () = log(console, "bound");
    match log(console, "matched") {
        () => console.println("unit"),
    }
    let found: Option<()> = Some(());
    match found {
        .Some(()) => console.println("some"),
        .None => console.println("none"),
    }
    if let .Some(()) = found {
        console.println("again");
    }
    let ((), n) = ((), 7);
    console.println(n);
}
