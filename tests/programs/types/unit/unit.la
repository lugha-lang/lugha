// The unit type `()`: a value like any other.
fun log(s: string) {
    println(s);
}

fun save(path: string): Result<(), string> {
    if path == "" {
        return Err("no path");
    }
    log("saved {path}");
    Ok(())
}

fun both(a: string, b: string): Result<(), string> {
    save(a)?;
    save(b)
}

fun id<T>(x: T): T = x;

struct Tick {
    at: i64,
    done: (),
}

fun main() {
    println(both("a", "b").debug());
    println(both("a", "").debug());
    let u: () = log("hi");
    println(u.debug());
    println(u == ());
    let us = [(), id(()), u];
    println(us.debug());
    println(us.len);
    let o: Option<()> = Some(());
    println("{o.debug()} {u.debug()}");
    let t = Tick { at: 3, done: () };
    println(t.debug());
    let done: Chan<()> = Chan.buffered(1);
    done.send(());
    println(done.recv().debug());
    let task: Task<()> = spawn log("from a task");
    let r: () = task.join();
    println(r.debug());
    let seen: Map<string, ()> = Map { "x": () };
    println(seen.has("x"));
}
