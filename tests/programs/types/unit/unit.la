// The unit type `()`: a value like any other.
fun log(console: Console, s: string) {
    console.println(s);
}

fun save(console: Console, path: string): Result<(), string> {
    if path == "" {
        return Err("no path");
    }
    log(console, "saved {path}");
    Ok(())
}

fun both(console: Console, a: string, b: string): Result<(), string> {
    save(console, a)?;
    save(console, b)
}

fun id<T>(x: T): T = x;

struct Tick {
    at: i64,
    done: (),
}

fun main(console: Console, root: Scope) {
    console.println(both(console, "a", "b").debug());
    console.println(both(console, "a", "").debug());
    let u: () = log(console, "hi");
    console.println(u.debug());
    console.println(u == ());
    let us = [(), id(()), u];
    console.println(us.debug());
    console.println(us.len);
    let o: Option<()> = Some(());
    console.println("{o.debug()} {u.debug()}");
    let t = Tick { at: 3, done: () };
    console.println(t.debug());
    let done: Chan<()> = Chan.buffered(1);
    done.send(());
    console.println(done.recv().debug());
    let task: Task<()> = root.spawn(log(console, "from a task"));
    let r: () = task.join().unwrap();
    console.println(r.debug());
    let seen: Map<string, ()> = Map { "x": () };
    console.println(seen.has("x"));
}
