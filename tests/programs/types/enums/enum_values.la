// Enum payloads are immutable, so enum copies share them; the copies that
// keep value semantics happen at construction and when a binding is stored.
enum Job { Batch(i64[]), Idle }

fun first(j: Job): i64 = match j {
    .Batch(xs) => xs[0],
    .Idle => -1,
};

fun main(console: Console) {
    let mut xs = [1, 2, 3];
    let a = Job.Batch(xs);
    xs[0] = 9;
    console.println(first(a));

    match a {
        .Batch(v) => {
            let mut w = v;
            w[0] = 7;
            console.println(w[0]);
        }
        .Idle => {}
    }
    console.println(first(a));

    let b = a;
    console.println(first(b));
    console.println(first(a));
    console.println(first(Job.Idle));
}
