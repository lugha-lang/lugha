// Two green threads allocate while `main` waits: what each makes is
// counted and freed on its own 1 MiB stack, which never overflows.
fun fill(n: i64): i64 {
    let mut xs: i64[] = [];
    for i in 0..n {
        xs.push(i);
    }
    xs.len
}

fun main(console: Console) {
    let a = spawn fill(300000);
    let b = spawn fill(200000);
    console.println(a.join() + b.join());
}
