// A loop walks a long list in a function that was handed it, and the list
// is let go of as the loop goes.
enum List {
    Nil,
    Cons(i64, List),
}

fun sum(list: List): i64 {
    let mut total = 0;
    let mut rest = list;
    while let .Cons(head, next) = rest {
        total += head;
        rest = next;
    }
    total
}

fun main(console: Console) {
    let mut list = List.Nil;
    for _ in 0..1_000_000 {
        list = List.Cons(1, list);
    }
    console.println(sum(list));
}
