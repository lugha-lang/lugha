// A chain of a million boxes, each holding the next, is freed at once when
// its first box is let go of.
struct Node { value: i64, next: Option<Ref<Node>> }

fun main(console: Console) {
    let mut head: Option<Ref<Node>> = None;
    for i in 0..1_000_000 {
        head = Some(Ref.new(Node { value: i, next: head }));
    }
    if let .Some(first) = head {
        console.println(first.get().value);
    }
}
