// The prelude's iterator types reached every way: a direct `next` call, a
// loop over one, a call through a bound, and a conversion to `Iter<u8>`.

fun total<I: Iter<i64>>(it: I): i64 {
    let mut t = 0;
    for x of it {
        t += x;
    }
    t
}

fun main(console: Console) {
    let mut r = range(0, 3);
    console.println(r.next().unwrap());
    for x of r {
        console.print(x);
    }
    console.println("");
    console.println(total(range(1, 4)));
    let mut b = "hi".bytes();
    console.println(b.next().unwrap());
    let it: Iter<u8> = b;
    console.println(it.count());
}
