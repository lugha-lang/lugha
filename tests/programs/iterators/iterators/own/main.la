// A module's own interface beside the prelude's `Iter`; loops still work by shape.

interface Sized {
    fun size(self): i64;
}

struct Count { n: i64, end: i64 }

impl Count {
    fun next(mut self): Option<i64> {
        if self.n == self.end {
            return None;
        }
        self.n += 1;
        Some(self.n)
    }
}

impl Sized for Count {
    fun size(self): i64 = self.end - self.n;
}

fun size_of<T: Sized>(x: T): i64 = x.size();

fun main(console: Console) {
    let c = Count { n: 0, end: 3 };
    console.println(size_of(c));
    let mut total = 0;
    for n of c {
        total += n;
    }
    console.println(total);
}
