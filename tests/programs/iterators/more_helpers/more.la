// Edges of the iterator helpers: uneven zips, empty chains, predicates that
// never or always hold, empty inner iterators, string and tied extremes,
// a missing position, a tuple built by the program (`zip` yields
// tuples), and laziness.

struct Naturals { n: i64 }

impl Naturals {
    fun next(mut self): Option<i64> {
        self.n += 1;
        Some(self.n)
    }
}

fun main(console: Console) {
    let short = [1].iter();
    console.println(short.zip([true, false].iter()).count());
    console.println(([true, false].iter().zip([7].iter()).collect()).debug());
    let none: i64[] = [];
    console.println(none.iter().chain(none.iter()).count());
    console.println(([5, 6].iter().take_while(fun(n) = n > 0).collect()).debug());
    console.println([5, 6].iter().skip_while(fun(n) = n > 0).count());
    console.println(range(0, 4).flat_map(fun(n) = range(0, n % 2)).count());
    console.println((["pear", "apple", "fig"].iter().min()).debug());
    console.println((["pear", "apple", "fig"].iter().max()).debug());
    console.println(none.iter().max().debug());
    console.println(([2, 1, 1].iter().position(fun(n) = n == 1)).debug());
    console.println(([2, 1].iter().position(fun(n) = n > 5)).debug());
    let p = ("x", 1.5);
    console.println(p.debug());
    console.println(p.1);
    let ends = (Naturals { n: 0 }).zip(["a", "b", "c"].iter());
    console.println(ends.map(fun(p) = p.0).sum());
}
