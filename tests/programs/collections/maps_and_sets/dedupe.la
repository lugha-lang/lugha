// Sets: the first of each value, and set algebra.
fun main(console: Console) {
    let xs = [3, 1, 3, 2, 1];
    let mut seen: Set<i64> = Set {};
    let mut firsts: i64[] = [];
    for x of xs {
        if seen.insert(x) {
            firsts.push(x);
        }
    }
    console.println(firsts.debug());
    console.println(seen.debug());
    console.println(seen.has(2));
    console.println(seen.has(9));
    let a = Set { 1, 2, 3 };
    let b = Set { 2, 3, 4 };
    console.println(a.union(b).debug());
    console.println(a.intersect(b).debug());
    console.println(a.minus(b).debug());
    let mut s = Set { "x", "y" };
    console.println(s.remove("x"));
    console.println(s.remove("x"));
    console.println(s.len);
    for v of s {
        console.println(v);
    }
}
