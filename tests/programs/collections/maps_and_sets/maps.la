// Maps and sets as values: copies, equality regardless
// of order, every key kind, nesting, removal and growth.
struct Point {
    x: i64,
    y: i64,
} with Key

enum Color {
    Red,
    Rgb(i64, i64, i64),
} with Key

fun main(console: Console) {
    let a = Map { "x": 1, "y": 2 };
    let mut b = a;
    b["z"] = 3;
    console.println(a.len);
    console.println(b.len);
    console.println(a == Map { "y": 2, "x": 1 });
    console.println(a == b);
    console.println(Set { 1, 2 } == Set { 2, 1 });
    let mut m = Map { "k": 10 };
    m["k"] = 11;
    console.println(m.get("k").debug());
    console.println(m.get("nope").debug());
    console.println(m.remove("k").debug());
    console.println(m.has("k"));
    console.println(m.debug());
    let points = Map { Point { x: 1, y: 2 }: "a", Point { x: 3, y: 4 }: "b" };
    console.println(points[Point { x: 3, y: 4 }]);
    let colors = Map { Color.Red: 0, Color.Rgb(1, 2, 3): 1 };
    console.println(colors[Color.Rgb(1, 2, 3)]);
    let grid = Map { (0, 0): '.', (0, 1): '#' };
    console.println(grid[(0, 1)]);
    let mut groups: Map<string, Set<i64>> = Map {};
    groups["even"] = Set { 2, 4 };
    groups["odd"] = Set { 1 };
    console.println(groups.debug());
    console.println(b.keys().debug());
    console.println(b.values().debug());
    let mut big: Map<i64, i64> = Map {};
    for i in 0..1000 {
        big[i] = i * i;
    }
    for i in 0..990 {
        big.remove(i);
    }
    console.println(big.len);
    console.println(big.keys().debug());
    console.println(big[999]);
    let doubled = [1, 2, 3].iter().map(fun(n: i64): (i64, i64) = (n, n * 2)).collect_map();
    console.println(doubled.debug());
    let unique = [5, 5, 6].iter().collect_set();
    console.println(unique.debug());
    let pairs: (string, i64)[] = a.iter().collect();
    console.println(pairs.debug());
    b.clear();
    console.println(b.debug());
}
