import bag { Bag };

fun main(console: Console) {
    let ages = Map { "ann": 31, "bo": 40 };
    let primes = Set { 2, 3, 5, 7 };
    let index = Map<string, i64[]> {};
    let empty: Set<char> = Set {};
    let name = "cy";
    let more = Map { name: 22 };
    let fruit = Bag { "apple", "apple", "pear" };
    console.println(ages.debug());
    console.println(primes.debug());
    console.println("{index.len} {empty.len} {more["cy"]}");
    console.println(fruit.counts["apple"]);
    if ages == (Map { "bo": 40, "ann": 31 }) {
        console.println("same");
    }
    console.println(empty.debug());
}
