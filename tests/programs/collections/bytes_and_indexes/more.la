// An empty file, appends, a missing file, every kind of invalid UTF-8
// (each after one valid byte), a valid four-byte character, and a u16
// index into a string.
fun main(console: Console, files: Fs) {
    let empty: u8[] = [];
    match files.cwd().write_bytes("e.bin", empty) {
        .Ok(n) => console.println(n),
        .Err(e) => console.println(e),
    }
    match files.cwd().read_bytes("e.bin") {
        .Ok(b) => console.println(b.len),
        .Err(e) => console.println(e),
    }
    match files.cwd().append_bytes("e.bin", [1, 2]) {
        .Ok(n) => console.println(n),
        .Err(e) => console.println(e),
    }
    match files.cwd().append_bytes("e.bin", [3]) {
        .Ok(n) => console.println(n),
        .Err(e) => console.println(e),
    }
    match files.cwd().read_bytes("e.bin") {
        .Ok(b) => console.println(b.debug()),
        .Err(e) => console.println(e),
    }
    match files.cwd().read_bytes("missing.bin") {
        .Ok(b) => console.println(b.debug()),
        .Err(e) => console.println("missing: {e}"),
    }
    let cases: u8[][] = [
        [65, 192, 128],
        [65, 224, 128, 128],
        [65, 237, 160, 128],
        [65, 244, 144, 128, 128],
        [65, 226, 130],
        [65, 128],
        [65, 255],
        [240, 159, 152, 128],
    ];
    for c of cases {
        console.println(string_from_utf8(c).debug());
    }
    let s = "abc";
    let at: u16 = 2;
    console.println(s[at]);
}
