fun main(console: Console) {
    // 0 is never reached: each helper stops at the element that decides.
    let xs = [1, 5, 0];
    console.println(xs.any(fun(x) = if x == 0 { panic("any went too far") } else { x > 3 }));
    console.println(xs.all(fun(x) = if x == 0 { panic("all went too far") } else { x < 3 }));
}
