// A hoisted path whose index is out of bounds: a loop
// that never runs is fine; one that runs panics at the write, as before.
fun main(console: Console) {
    let mut g = [[1, 2], [3, 4]];
    let k = 5;
    for j in 0..0 {
        g[k][j] = 1;
    }
    console.println("{g.debug()}");
    for j in 0..2 {
        g[k][j] = 1;
    }
    console.println("unreachable");
}
