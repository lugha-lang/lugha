// Loops that can share their arrays again keep a test on every
// write. Each copies inside the loop, then writes; the copy
// must keep its values.
struct S { v: i64[] }

impl S {
    fun first(self): i64 = self.v[0];
    fun keep(self): S = self;
}

fun id(xs: i64[]): i64[] = xs;

fun main(console: Console) {
    let mut xs = [1, 2];
    let mut seen: i64[][] = [];
    for i in 0..2 {
        seen.push(xs);
        xs[i] += 10;
    }
    console.println("{xs.debug()} {seen.debug()}");

    let mut a = [1, 2];
    let mut b: i64[] = [];
    for i in 0..2 {
        b = id(a);
        a[i] = 0;
    }
    console.println("{a.debug()} {b.debug()}");

    let mut s = S { v: [5, 6] };
    let mut kept: S[] = [];
    for i in 0..2 {
        kept.push(s.keep());
        s.v[i] = s.first() + 1;
    }
    console.println("{s.v.debug()} {kept[0].v.debug()} {kept[1].v.debug()}");

    let mut c = [1, 2];
    let mut fs: (fun(): i64[])[] = [];
    for i in 0..2 {
        fs.push(fun(): i64[] = c);
        c[i] = 7;
    }
    console.println("{c.debug()} {fs[0]().debug()} {fs[1]().debug()}");

    let mut p = [1, 2];
    let mut q = [3, 4];
    for i in 0..2 {
        swap(p, q);
        p[0] += 100;
    }
    console.println("{p.debug()} {q.debug()}");

    let mut d = [1, 2];
    let e = [8, 9];
    let mut f: i64[] = [];
    for i in 0..2 {
        if i == 1 {
            d = e;
        }
        d[0] += 1;
        f = e;
    }
    console.println("{d.debug()} {e.debug()} {f.debug()}");

    let mut g = [[1], [2]];
    let row = [5];
    for i in 0..2 {
        g[i] = row;
        g[i][0] += i;
    }
    console.println("{g.debug()} {row.debug()}");

    let mut h = [[1], [2]];
    let mut rows: i64[][] = [];
    for i in 0..2 {
        let r = h[i];
        rows.push(r);
        h[i][0] *= 10;
    }
    console.println("{h.debug()} {rows.debug()}");

    let mut m = [[1, 2], [3, 4]];
    let mut olds: i64[][] = [];
    for r of mut m {
        olds.push(r);
        r[0] = 0;
    }
    console.println("{m.debug()} {olds.debug()}");

    // An index changed inside the loop.
    let mut n = [[1, 2], [3, 4]];
    let mut k = 0;
    let mut keep: i64[] = [];
    for i in 0..2 {
        keep = n[1];
        n[k][1] = 0;
        k = 1;
    }
    console.println("{n.debug()} {keep.debug()}");
}
