// User-defined order: `impl Ord` with a hand-written `cmp`, used by `<`,
// `min`, `sort`, tuples and `T: Ord` alike.
import std.math;

struct Score { loss: f64, name: string } with Eq

impl Ord for Score {
    fun cmp(self, o: Score): Ordering =
        if self.loss < o.loss {
            Ordering.Less
        } else if self.loss > o.loss {
            Ordering.Greater
        } else {
            Ordering.Equal
        };
}

enum Level { Low, Mid, High } with Eq

impl Level {
    fun rank(self): i64 = match self {
        .Low => 0,
        .Mid => 1,
        .High => 2,
    };
}

impl Ord for Level {
    fun cmp(self, o: Level): Ordering =
        if self.rank() < o.rank() {
            Ordering.Less
        } else if self.rank() > o.rank() {
            Ordering.Greater
        } else {
            Ordering.Equal
        };
}

struct Box<T> { v: T } with Eq

impl<T: Ord> Ord for Box<T> {
    fun cmp(self, o: Box<T>): Ordering =
        if self.v < o.v {
            Ordering.Less
        } else if o.v < self.v {
            Ordering.Greater
        } else {
            Ordering.Equal
        };
}

fun largest<T: Ord>(xs: T[]): T {
    let mut best = xs[0];
    for x of xs {
        if best < x {
            best = x;
        }
    }
    best
}

fun names(xs: Score[]): string = xs.map(fun(s: Score): string = s.name).join(" ");

fun main(console: Console) {
    let a = Score { loss: 2.0, name: "a" };
    let b = Score { loss: 1.0, name: "b" };
    let c = Score { loss: 2.0, name: "c" };
    console.println("{a < b} {a <= c} {a > b} {a >= c} {b < a} {a < c}");
    console.println("{Level.Low < Level.High} {Level.High <= Level.Mid} {Level.Mid > Level.Low} {Level.Mid >= Level.Mid}");
    console.println("{math.min(a, b).name} {math.max(a, b).name} {math.clamp(Level.High, Level.Low, Level.Mid).rank()}");
    let scores = [a, b, c, Score { loss: 0.5, name: "d" }];
    console.println("{scores.iter().min().unwrap().name} {scores.iter().max().unwrap().name}");
    console.println(names(scores.sort()));
    console.println("{(a, 2) < (c, 1)} {(c, 1) < (a, 2)}");
    console.println(largest(scores).name);
    let up = Box { v: 1 } < Box { v: 2 };
    let top = largest([Box { v: "x" }, Box { v: "z" }, Box { v: "y" }]);
    console.println("{up} {top.v}");
    console.println(a == c);
}
