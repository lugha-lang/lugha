// Methods of the right shape don't make a type a `Shape`, and a block must
// define what its interface asks for.
interface Shape { fun area(self): f64; }

struct Circle { r: f64 }
impl Circle { fun area(self): f64 = self.r; }

struct Square { side: f64 }
impl Shape for Square { fun area(self): i64 = 1; fun extra(self) {} }

fun total<T: Shape>(xs: T[]): f64 = xs.len.round<f64>();

fun main() {
    println(total([Circle { r: 1.0 }]));
    let s: Shape = Circle { r: 1.0 };
    println(Shape.area(Circle { r: 1.0 }));
}
