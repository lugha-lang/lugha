// Blocks in the type's module and in the interface's.
import geo;
import shapes;
fun total(xs: shapes.Shape[]): f64 {
    let mut t = 0.0;
    for x of xs { t += x.area(); }
    t
}
fun main(console: Console) {
    let sq = geo.Square { s: 2.0 };
    let c = geo.Circle { r: 1.0 };
    console.println(total([sq, c]));
    console.println(sq.name());
    console.println(c.name());
    console.println(shapes.Shape.area(sq));
}
