// A type implements an interface only through `impl I for T`; its own
// method of the same name stays its own, and `Shape.area(c)` reaches the
// interface's.
interface Shape {
    fun area(self): f64;
    fun describe(self): string = "a shape of area {self.area()}";
}

interface Named { fun area(self): f64; }

struct Circle { r: f64 }

impl Circle {
    fun area(self): f64 = 0.0;
}

impl Shape for Circle {
    fun area(self): f64 = 3.14159 * self.r * self.r;
}

fun total<T: Shape>(xs: T[]): f64 {
    let mut sum = 0.0;
    for x of xs { sum += x.area(); }
    sum
}

fun main(console: Console) {
    let c = Circle { r: 2.0 };
    let shapes: Shape[] = [c];
    console.println(c.area());
    console.println(Shape.area(c));
    console.println(c.describe());
    console.println(total([c, c]));
    console.println(shapes[0].area());
    console.println(shapes[0].describe());
}
