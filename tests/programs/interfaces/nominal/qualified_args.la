// A qualified call with several arguments, as a statement and as a value.
interface Sink {
    fun put(self, x: i64, tag: string);
    fun sum(self, a: i64, b: i64): i64 = a + b;
}
struct Shout { console: Console }
impl Sink for Shout { fun put(self, x: i64, tag: string) { self.console.println("{tag}{x}"); } }
fun main(console: Console) {
    Sink.put(Shout { console: console }, 5, "#");
    console.println(Sink.sum(Shout { console: console }, 2, 3));
}
