// Two blocks cover `Point[]`: no specialization.
interface Show {
    fun label(self): string;
}

struct Point { x: i64 }

impl Show for Point {
    fun label(self): string = "p";
}

impl<T: Show> Show for T[] {
    fun label(self): string = "all";
}

impl Show for Point[] {
    fun label(self): string = "points";
}

fun main() {}
