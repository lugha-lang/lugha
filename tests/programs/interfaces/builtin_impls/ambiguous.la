// Two interfaces give `f64` a `label`: the call is qualified.
interface Show {
    fun label(self): string;
}

interface Labels {
    fun label(self): string;
}

impl Show for f64 {
    fun label(self): string = "a";
}

impl Labels for f64 {
    fun label(self): string = "b";
}

fun main() {
    println(2.0.label());
}
