// Built-in types implement interfaces: a number, `string`, every array of a
// `Show` type, `Option<T>`; method syntax, qualified calls, bounds and
// interface values, and the prelude's own blocks.
interface Show {
    fun label(self): string;
}

impl Show for f64 {
    fun label(self): string = "{self} m";
}

impl Show for string {
    fun label(self): string = "\"{self}\"";
}

impl<T: Show> Show for T[] {                       // every array of a `Show` type
    fun label(self): string = "[" + self.map(fun(x: T): string = x.label()).join(", ") + "]";
}

impl<T: Show> Show for Option<T> {
    fun label(self): string = match self {
        Some(x) => "some " + x.label(),
        None => "none",
    };
}

struct Point { x: f64, y: f64 }

impl Show for Point {
    fun label(self): string = "({self.x}, {self.y})";
}

fun all<T: Show>(xs: T[]): string = xs.label();

fun main() {
    println(2.5.label());                                       // 2.5 m
    println(Show.label("hi"));                                  // "hi"
    println(all([[1.0, 2.0], [3.0]]));                         // [[1.0 m, 2.0 m], [3.0 m]]
    println(Some(Point { x: 1.0, y: 2.0 }).label());            // some (1.0, 2.0)
    let items: Show[] = [1.5, "a", Point { x: 0.0, y: 0.0 }];   // interface values
    for i of items {
        println(i.label());
    }
    println(3.cmp(4) == Ordering.Less);                        // true: the prelude's blocks count too
}
