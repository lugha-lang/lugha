// A block for a type built from a program's type lives in that type's module.
import geo;
import shapes;

fun all<T: shapes.Show>(x: T): string = x.label();

fun main(console: Console) {
    let ps = [geo.Point { x: 1.0, y: 2.0 }, geo.Point { x: 3.0, y: 4.0 }];
    console.println(ps.label());
    console.println(all(ps));
    let o: Option<geo.Point> = None;
    console.println(shapes.Show.label(o));
    console.println(Some(ps[1]).label());
    let items: shapes.Show[] = [ps, 2.5];
    for i of items {
        console.println(i.label());
    }
}
