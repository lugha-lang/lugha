// A type that asks for `Eq` but has a part that isn't: E0451 names the
// part at the declaration. A type that doesn't ask isn't `Eq` (E0422).
struct Job { id: i64, run: fun(i64): i64 } with Eq
struct Shelf { jobs: Job[] } with Eq
struct Note { text: string }

fun same<T: Eq>(a: T, b: T): bool = a == b;

fun main() {
    let j = Job { id: 1, run: fun(x: i64): i64 = x };
    let a = j == j;
    let b = same(Shelf { jobs: [j] }, Shelf { jobs: [] });
    let c = Note { text: "a" } == Note { text: "a" };
}
