// Converting between interfaces along `extends`: chains, independent
// copies, type patterns, generic code, `?`.

interface Named {
    fun name(self): string;
}

interface Pet: Named {
    fun sound(self): string;
    fun intro(self): string = "{self.name()} says {self.sound()}";
}

interface Animal: Pet {
    fun rename(mut self, to: string);
}

struct Dog { called: string }

impl Named for Dog {
    fun name(self): string = self.called;
}

impl Pet for Dog {
    fun sound(self): string = "woof";
}

impl Animal for Dog {
    fun rename(mut self, to: string) { self.called = to; }
}

fun greet(n: Named): string = match n {
    d: Dog => "dog {d.called}",
    _ => "someone",
};

fun as_named<T: Named>(x: T): Named = x;

interface Problem {
    fun text(self): string;
}

interface ParseProblem: Problem {
    fun at(self): i64;
}

struct BadChar { pos: i64 }

impl Problem for BadChar {
    fun text(self): string = "bad char at {self.pos}";
}

impl ParseProblem for BadChar {
    fun at(self): i64 = self.pos;
}

fun parse(s: string): Result<i64, ParseProblem> =
    if s == "ok" { Ok(1) } else { Err(BadChar { pos: 3 }) };

fun run(s: string): Result<i64, Problem> {
    let n = parse(s)?;
    Ok(n + 1)
}

fun main(console: Console) {
    let a: Animal = Dog { called: "rex" };
    let p: Pet = a;
    console.println(p.intro());
    let n: Named = p;
    console.println(greet(n));

    let mut m: Animal = Dog { called: "max" };
    let before: Named = m;
    m.rename("bo");
    console.println("{before.name()} {m.name()}");

    let pet: Pet = Dog { called: "fido" };
    console.println(greet(as_named(pet)));

    for s of ["ok", "no"] {
        match run(s) {
            .Ok(v) => console.println(v),
            .Err(e) => console.println(e.text()),
        }
    }
}
