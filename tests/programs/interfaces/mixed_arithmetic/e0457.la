// An operand must fit exactly one block, and some block.
struct V { x: f64 }

impl V {
    fun mul(mut self, w: V) {
        self.x *= w.x;
    }
}

impl Mul<f64> for V {
    fun mul(self, k: f64): V = V { x: self.x * k };
}

impl Mul<u8> for V {
    fun mul(self, n: u8): V = V { x: self.x * (n as f64) };
}

impl Mul<i64> for V {
    fun mul(self, n: i64): V = V { x: self.x * (n.round<f64>()) };
}

fun main() {
    let v = V { x: 1.0 };
    let a = v * 2;
    let b = v * "two";
    let mut k = 2.0;
    k *= v;
}
