interface Named {
    fun name(self): string;
    fun describe(self): string = "named {self.name()}";
}

interface Shown {
    fun describe(self): string = "shown";
}

struct P { x: i64 }

impl Named for P {
    fun name(self): string = "p";
}

impl Shown for P {}

fun main() {
    println(P { x: 1 }.describe());
}
