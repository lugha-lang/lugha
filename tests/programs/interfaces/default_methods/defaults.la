// Default methods: through values and bounds, overridden,
// calling each other, on generic types and through an empty `impl`.
interface Shape {
    fun area(self): f64;
    fun name(self): string = "shape";
    fun describe(self): string = "{self.name()} of area {self.area()}";
}

struct Circle { r: f64 }

impl Shape for Circle {
    fun area(self): f64 = 3.0 * self.r * self.r;
    fun name(self): string = "circle";
}

struct Sq { side: f64 }

impl Shape for Sq {
    fun area(self): f64 = self.side * self.side;
}

struct Many<T> { items: T[] }

impl Shape for Many<T> {
    fun area(self): f64 = self.items.len.round<f64>();
}

fun tell<T: Shape>(x: T): string = x.describe();

interface Named {
    fun label(self): string = "a value";
}

struct Seven { n: i64 }

impl Named for Seven {}

fun main() {
    let shapes: Shape[] = [Circle { r: 1.0 }, Sq { side: 2.0 }, Many { items: [1, 2, 3] }];
    for s of shapes {
        println(s.describe());
    }
    println(tell(Sq { side: 3.0 }));
    println(tell(Circle { r: 2.0 }));
    let n: Named = Seven { n: 7 };
    println(n.label());
}
