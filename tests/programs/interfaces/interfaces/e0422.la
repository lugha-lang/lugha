// Having an `area` method isn't enough: `Circle` needs `impl Shape for Circle`.
interface Shape {
    fun area(self): f64;
}

struct Circle { r: f64 }

impl Circle {
    fun area(self): f64 = 3.0 * self.r * self.r;
}

fun total<T: Shape>(xs: T[]): f64 {
    let mut sum = 0.0;
    for x of xs {
        sum += x.area();
    }
    sum
}

fun main(console: Console) {
    console.println(total([Circle { r: 1.0 }]));
}
