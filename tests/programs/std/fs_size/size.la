// `fs.size`: a regular file's size from `stat`, links
// followed, without opening it; a folder, a FIFO, a missing path and a NUL
// byte are `Err`; a sparse 5 GB file proves sizes past 32 bits.
import std.fs;
import std.process;

fun say(console: Console, label: string, r: Result<i64, string>) {
    match r {
        .Ok(n) => console.println("{label}: {n}"),
        .Err(e) => console.println("{label}: Err({e})"),
    }
}

fun main(console: Console, files: Fs): i32 {
    let w = files.cwd().write_file("note.txt", "hello, size");
    let e = files.cwd().write_file("empty.txt", "");
    say(console, "note", fs.size("note.txt"));
    say(console, "empty", fs.size("empty.txt"));
    let made = fs.make_dir("box");
    say(console, "folder", fs.size("box"));
    say(console, "missing", fs.size("nope.txt"));
    say(console, "nul", fs.size("note\0.txt"));
    let l = process.run("ln", ["-s", "note.txt", "link"]);
    say(console, "link", fs.size("link"));
    let f = process.run("mkfifo", ["pipe"]);
    say(console, "fifo", fs.size("pipe"));
    let t = process.run("truncate", ["-s", "5G", "big"]);
    say(console, "big", fs.size("big"));
    0
}
