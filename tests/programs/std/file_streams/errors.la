// File streams' errors: a missing file or folder, a
// NUL in the path, `read` sizes out of range, and a line that isn't UTF-8,
// which is skipped so the next line still reads.

fun main(console: Console, files: Fs) {
    console.println((files.cwd().open("missing.txt").map(fun(f: File): i64 = 0)).debug());
    console.println((files.cwd().create("no/such/folder.txt").map(fun(f: File): i64 = 0)).debug());
    console.println((files.cwd().append("a\0b").map(fun(f: File): i64 = 0)).debug());
    let bad: u8[] = [111, 107, 10, 255, 10, 102, 105, 110, 101, 10];
    let w = files.cwd().write_bytes("bad.txt", bad);
    let f = files.cwd().open("bad.txt").unwrap();
    console.println(f.read(0).debug());
    console.println(f.read(16777217).debug());
    console.println(f.read_line().debug());
    console.println(f.read_line().debug());
    console.println(f.read_line().debug());
    console.println(f.read_line().debug());
    f.close();
}
