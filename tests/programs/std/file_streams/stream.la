// File streams: create, append, read lines over
// `\r\n` and a last line without `\n`, the end of the file, the wrong mode,
// closing twice, and using a closed file.

fun run(console: Console, files: Fs): Result<(), string> {
    let out = files.cwd().create("notes.txt")?;
    out.write_text("first\r\nsecond\n")?;
    out.write("last".to_bytes())?;
    console.println(out.read(10).debug());
    console.println(out.read_line().debug());
    out.close();

    let log = files.cwd().append("notes.txt")?;
    log.write_text("!\n")?;
    log.close();

    let f = files.cwd().open("notes.txt")?;
    let copy = f;
    while true {
        match f.read_line()? {
            .Some(line) => console.println("[{line}]"),
            .None => {
                break;
            }
        }
    }
    console.println(copy.read_line().debug());
    console.println(f.read(10).debug());
    console.println(f.write_text("x").debug());
    console.println((f.write("y".to_bytes())).debug());
    f.close();
    copy.close();
    console.println(f.read(10).debug());
    console.println(f.read_line().debug());
    console.println(copy.write_text("x").debug());

    let again = files.cwd().create("notes.txt")?;
    again.write_text("fresh")?;
    again.close();
    console.println(files.cwd().read_file("notes.txt").debug());
    Ok(())
}

fun main(files: Fs, console: Console) {
    console.println(run(console, files).debug());
}
