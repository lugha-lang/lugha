// Changing the working directory: relative paths and
// child processes follow it. Runs in a fresh scratch directory.
import std.env;
import std.fs;
import std.process;

fun show(r: Result<i64, string>): string = match r {
    .Ok(n) => "ok {n}",
    .Err(e) => "err {e}",
};

fun main(console: Console, files: Fs) {
    let start = env.current_dir().unwrap_or("?");
    let made = fs.make_dir("sub");
    let wrote = files.cwd().write_file("sub/note.txt", "hello");
    console.println(show(env.set_current_dir("sub")));
    let here = env.current_dir().unwrap_or("?");
    console.println("{here.ends_with("/sub")} {here == start + "/sub"}");
    console.println(files.cwd().read_file("note.txt").debug());
    console.println(fs.list_dir(".").debug());
    match process.run("ls", []) {
        .Ok(out) => console.println(out.stdout.trim()),
        .Err(e) => console.println(e),
    }
    console.println(show(env.set_current_dir("..")));
    console.println(env.current_dir().unwrap_or("?") == start);
    console.println(show(env.set_current_dir("nope")));
    console.println(show(env.set_current_dir("sub/note.txt")));
    console.println(show(env.set_current_dir("a\0b")));
}
