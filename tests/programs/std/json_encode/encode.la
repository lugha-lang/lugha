import std.json;

struct Person { name: string, age: i64, email: Option<string>, tags: string[] } with json.Json
enum Shape { Dot, Circle(f64), Rect(f64, f64) } with json.Json
enum Tree { Leaf(i64), Node(Tree[]) } with json.Json
struct Pair<T> { a: T, b: T } with json.Json
struct Doc { meta: json.Value, n: u8 } with json.Json

fun show<T: json.Json>(console: Console, x: T) {
    console.println(json.stringify(json.encode(x)).unwrap());
}

fun main(console: Console) {
    show(console, Person { name: "ada", age: 36, email: None, tags: ["math"] });
    show(console, Person { name: "bob", age: 7, email: Some("b@x"), tags: [] });
    show(console, [Shape.Dot, Shape.Circle(1.5), Shape.Rect(2.0, 3.0)]);
    show(console, Tree.Node([Tree.Leaf(1), Tree.Node([])]));
    show(console, Pair { a: 1, b: 2 });
    show(console, Pair { a: "x", b: "y" });
    let n8: i8 = -8;
    let u16v: u16 = 65535;
    let i32v: i32 = -2147483648;
    let u32v: u32 = 4294967295;
    show(console, (n8, u16v, i32v, u32v));
    let big: u64 = 18446744073709551615;
    let small: u64 = 5;
    show(console, [small, big]);
    let f: f32 = 1.5;
    show(console, (f, 0.1, true, 'é'));
    show(console, ());
    let m: Map<string, i64> = Map { "b": 2, "a": 1 };
    show(console, m);
    let mi: Map<i64, bool> = Map { 3: true, -1: false };
    show(console, mi);
    let s: Set<string> = Set { "x", "y" };
    show(console, s);
    let o: Option<Option<i64>> = Some(None);
    show(console, o);
    show(console, Some(Some(4)));
    let r: Result<i64, string> = Err("no");
    show(console, r);
    show(console, Doc { meta: json.parse("{{\"k\": [1]}}").unwrap(), n: 255 });
    show(console, "plain");
    let empty: i64[] = [];
    show(console, empty);
    let nan = f64.from_bits(9221120237041090560);
    console.println(json.stringify(json.encode([nan])).is_err());
    console.println(json.encode(n8).debug());
}
