// std.fs, in a fresh scratch directory: making,
// listing, testing and removing files and folders.
import std.fs;

fun show(r: Result<i64, string>): string = match r {
    .Ok(n) => "ok {n}",
    .Err(e) => "err {e}",
};

fun list(path: string): string = match fs.list_dir(path) {
    .Ok(names) => "{names.debug()}",
    .Err(e) => e,
};

fun main(console: Console, files: Fs) {
    console.println(show(fs.make_dir("box")));
    console.println(show(fs.make_dir("box")));
    console.println(show(fs.make_dirs("deep/er/est")));
    console.println(show(fs.make_dirs("deep/er/est")));
    let a = files.cwd().write_file("box/b.txt", "b");
    let b = files.cwd().write_file("box/a.txt", "a");
    let c = files.cwd().write_file("box/Z.txt", "z");
    console.println(list("box"));
    console.println("{fs.exists("box")} {fs.is_dir("box")} {fs.is_file("box")}");
    console.println("{fs.exists("box/a.txt")} {fs.is_dir("box/a.txt")} {fs.is_file("box/a.txt")}");
    console.println("{fs.exists("nope")} {fs.is_dir("nope")} {fs.is_file("nope")}");
    console.println(show(fs.remove_file("box")));
    console.println(show(fs.remove_dir("box")));
    console.println(show(fs.remove_file("box/a.txt")));
    console.println(show(fs.remove_file("box/b.txt")));
    console.println(show(fs.remove_file("box/Z.txt")));
    console.println(show(fs.remove_dir("box")));
    console.println(fs.exists("box"));
    console.println(list("nope"));
    console.println(list("deep"));
    console.println(show(fs.make_dir("bad\0name")));
    console.println(fs.exists("bad\0name"));
}
