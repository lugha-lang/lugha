// std.process: programs run with an argument list,
// never through a shell, in a fresh scratch directory.
import std.process;
import std.random;

fun show(r: Result<process.Output, string>): string = match r {
    .Ok(o) => "{o.code} {o.stdout.split("\n").debug()} {o.stderr.split("\n").debug()}",
    .Err(e) => "err {e}",
};

fun main(console: Console, fs: Fs) {
    // An argument with a space stays one argument.
    console.println(show(process.run("echo", ["a b", "c"])));
    console.println(show(process.run_with("sort", [], "b\na\n")));
    console.println(show(process.run("sh", ["-c", "exit 3"])));
    console.println(show(process.run("sh", ["-c", "kill -9 $$"])));
    console.println(show(process.run("no-such-program-xyz", [])));
    // Shell syntax in an argument is just text.
    console.println(show(process.run("echo", ["; echo injected"])));
    console.println(show(process.run("sh", ["-c", "echo out; echo err >&2"])));
    console.println("before call");
    match process.call("echo", ["hi"]) {
        .Ok(code) => console.println("call {code}"),
        .Err(e) => console.println(e),
    }
    console.println(show(process.run("echo", ["a\0b"])));
    console.println(show(process.run("ec\0ho", [])));
    console.println(show(process.run("printf", ["\\377"])));
    // Both pipes full at once can't deadlock.
    let big = "head -c 1000000 /dev/zero | tr '\\0' a; head -c 1000000 /dev/zero | tr '\\0' b >&2";
    match process.run("sh", ["-c", big]) {
        .Ok(o) => console.println("{o.stdout.len} {o.stderr.len}"),
        .Err(e) => console.println(e),
    }
    // Only 0, 1 and 2 reach a child, even after the runtime opened files.
    let mut rng = random.from_os();
    let w = fs.cwd().write_file("note.txt", "x");
    let a = fs.cwd().append_file("note.txt", "y");
    let r = fs.cwd().read_file("note.txt");
    console.println(show(process.run("ls", ["/proc/self/fd"])));
}
