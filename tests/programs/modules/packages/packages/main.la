// Packages: `geo` from lugha.toml; geo uses its own package `mathx`.
import geo.shapes;
// A local module named like geo's: different keys, no clash.
import util.names;

fun main(console: Console) {
    let c = shapes.circle(2.0);
    console.println(c.area());
    console.println(shapes.label(c));
    console.println(names.kind());
}
