// include_bytes and include_str: a file's contents built into the program.
import art.logo;

const BLOB: u8[] = include_bytes("data/blob.bin");
const HELLO: string = include_str("./data/hello.txt");
const FIRST: u8 = include_bytes("data/blob.bin")[1];

fun main(console: Console) {
    console.println(BLOB.len);
    console.println(BLOB[0]);
    console.println(BLOB[255]);
    console.println(FIRST);
    console.print(HELLO);
    console.println(HELLO.len);
    // A copy is its own array: writing it leaves the constant as it was.
    let mut b = BLOB;
    b[0] = 9;
    b.push(7);
    console.println("{b[0]} {b.len} {BLOB[0]} {BLOB.len}");
    let mut c = include_bytes("data/blob.bin");
    c.pop();
    console.println(c.len);
    // In any expression, not only a constant.
    console.println(include_bytes("data/empty.txt").len);
    console.println("[{include_str("data/empty.txt")}]");
    console.println(logo.svg());
    console.println(logo.SIZE);
}
