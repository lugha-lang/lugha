// Glob re-exports: `gtk.Point` is `raw.Point`.
import gtk { Point, Dir, twice, Widget };
import raw;

fun keep(w: Widget): raw.Widget = w;

fun main(console: Console) {
    let p: raw.Point = Point { x: twice(2), y: gtk.twice(3) };
    let q: gtk.Point = p;
    console.println(q.x + q.y);
    console.println(match Dir.Up { .Up => "up", .Down => "down" });
    console.println(gtk.run());
}
