// Modules: a nested module, an import cycle, private fields and
// helpers, a `Point` in two modules, and a panic located inside a module.
import parity;
import shapes.circle;
import range;
import points;

struct Point { x: i64 }

fun main(console: Console) {
    console.println(parity.even(10));
    console.println(parity.odd(7));
    let c = circle.Circle { r: 2.0 };
    console.println(c.area());
    let s = circle.Shape.Round(c);
    match s {
        .Round(k) => console.println(k.r),
        .Flat => console.println("flat"),
    }
    let r = range.Range.new(9, 3);
    console.println(r.len());
    console.println(r.contains(4));
    let p = Point { x: 1 };
    let q = points.Point { x: 2, y: 3 };
    console.println(p.x + q.x + q.y);
    console.println(range.checked(100));
}
