// Built-in generic types take written type arguments too.
fun main(console: Console) {
    let c = Chan<string>.buffered(2);
    c.send("hi");
    console.println(c.recv().debug());
    let r = Ref<f32>.new(1.5);
    r.set(2.5);
    console.println(r.get());
    let none = Option<i64>.None;
    console.println(none.debug());
    // Comparisons stay comparisons.
    let (a, b, c2) = (1, 2, 3);
    console.println(a < b);
    console.println([a < b, c2 > a].debug());
}
