struct Stack<T> { items: T[] }

impl<T> Stack<T> {
    fun new(): Stack<T> = Stack { items: [] };
    fun push(mut self, x: T) { self.items.push(x); }
    fun pop(mut self): Option<T> = self.items.pop();
    fun size(self): i64 = self.items.len;
}

fun main(console: Console) {
    let mut ints: Stack<i64> = Stack.new();
    ints.push(1);
    ints.push(2);
    let mut words: Stack<string> = Stack.new();
    words.push("x");
    console.println(ints.size() + words.size());
    match ints.pop() {
        .Some(n) => console.println(n),
        .None => console.println(0),
    }
    match words.pop() {
        .Some(w) => console.println(w),
        .None => console.println("empty"),
    }
    match words.pop() {
        .Some(w) => console.println(w),
        .None => console.println("empty"),
    }
}
