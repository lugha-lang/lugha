struct Point { x: i64, y: i64 } with Eq

fun contains<T: Eq>(xs: T[], x: T): bool {
    for y of xs {
        if y == x { return true; }
    }
    false
}

fun largest<T: Ord>(xs: T[]): Option<T> {
    if xs.len == 0 { return None; }
    let mut best = xs[0];
    for x of xs {
        if x > best { best = x; }
    }
    Some(best)
}

struct Pair<A, B> { a: A, b: B } with Eq

fun main(console: Console) {
    let ps = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    console.println(contains(ps, Point { x: 3, y: 4 }));
    console.println(contains(ps, Point { x: 4, y: 3 }));
    console.println(contains([[1], [2, 3]], [2, 3]));
    console.println(Pair { a: 1, b: "x" } == Pair { a: 1, b: "x" });
    match largest([3, 9, 4]) {
        .Some(f) => console.println(f),
        .None => console.println(0),
    }
    match largest(["pear", "apple", "plum"]) {
        .Some(w) => console.println(w),
        .None => console.println("none"),
    }
}
