// Constants across modules: `m.NAME`, `import m { NAME }`, and one built from another module's.
import geo { SIDES };

const AREA: i64 = geo.UNIT.w * geo.UNIT.h * SIDES;

fun main(console: Console) {
    console.println(geo.UNIT.debug());
    console.println(SIDES);
    console.println(AREA);
    console.println(geo.describe());
}
