// A fake `Console`: an ordinary type that implements the interface. A
// capability may be handed to other tasks, so what the fake records lives
// in an actor, which one task owns.
actor Lines {
    all: string[],
    fun add(mut self, line: string) { self.all.push(line); }
    fun get(self): string[] = self.all;
}

struct Recorder { lines: Lines }

impl Console for Recorder {
    fun print(self, x: Display) { self.lines.add(x.show()); }
    fun println(self, x: Display) { self.print(x); }
    fun eprint(self, x: Display) { self.print(x); }
    fun eprintln(self, x: Display) { self.print(x); }
    fun read_line(self): Result<Option<string>, string> = Ok(Some("canned"));
    fun read_bytes(self): Result<u8[], string> = Ok([]);
    fun flush(self) {}
}

fun greet(console: Console, name: string) {
    console.println("hello, {name}");
    match console.read_line() {
        .Ok(.Some(line)) => console.println("got {line}"),
        _ => {}
    }
}

fun main(console: Console, root: Scope) {
    let lines = root.spawn(Lines { all: [] });
    greet(Recorder { lines: lines }, "fake");
    console.println(lines.get().debug());
    lines.stop();
    greet(console, "real");
}
