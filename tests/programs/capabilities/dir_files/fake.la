// A fake `Dir` writes only the core; `write_file`, `append_file` and
// `make_dirs` come from the interface's defaults. Its files are fakes too.
// A capability may be handed to other tasks, so the fakes' state lives in
// an actor, owned by one task, and a file's lines in a channel.
actor Store {
    files: Map<string, u8[]>,
    folders: string[],
    fun get(self, path: string): Option<u8[]> = self.files.get(path);
    fun put(mut self, path: string, bytes: u8[]) { self.files[path] = bytes; }
    fun names(self): string[] = self.files.keys().sort();
    fun add_folder(mut self, path: string) { self.folders.push(path); }
    fun made(self): string[] = self.folders;
}

struct Memory { store: Store }

struct Tape { lines: Receiver<string> }

impl File for Tape {
    fun read(self, max: i64): Result<u8[], string> = Ok([]);
    fun read_line(self): Result<Option<string>, string> = match self.lines.try_recv() {
        .Ready(line) => Ok(Some(line)),
        _ => Ok(None),
    };
    fun write(self, bytes: u8[]): Result<(), string> = Err("read-only tape");
    fun close(self) {}
}

impl Dir for Memory {
    fun dir(self, path: string): Result<Dir, string> = Err("one folder only");
    fun read_only(self): Dir = self;
    fun read_file(self, path: string): Result<string, string> = match self.read_bytes(path) {
        .Ok(b) => string_from_utf8(b),
        .Err(e) => Err(e),
    };
    fun read_bytes(self, path: string): Result<u8[], string> = match self.store.get(path) {
        .Some(b) => Ok(b),
        .None => Err("No such file or directory"),
    };
    fun write_bytes(self, path: string, bytes: u8[]): Result<i64, string> {
        self.store.put(path, bytes);
        Ok(bytes.len)
    }
    fun append_bytes(self, path: string, bytes: u8[]): Result<i64, string> {
        let old = self.read_bytes(path).unwrap_or([]);
        let n = self.write_bytes(path, old + bytes)?;
        Ok(bytes.len)
    }
    fun list(self, path: string): Result<string[], string> = Ok(self.store.names());
    fun make_dir(self, path: string): Result<(), string> {
        self.store.add_folder(path);
        Ok(())
    }
    fun remove_file(self, path: string): Result<(), string> = Err("not here");
    fun remove_dir(self, path: string): Result<(), string> = Err("not here");
    fun exists(self, path: string): bool = self.is_file(path) || self.is_dir(path);
    fun is_dir(self, path: string): bool = self.store.made().iter().any(fun(f: string): bool = f == path);
    fun is_file(self, path: string): bool = self.store.get(path).is_some();
    fun size(self, path: string): Result<i64, string> = self.read_bytes(path).map(fun(b: u8[]): i64 = b.len);
    fun rename(self, from: string, to: string): Result<(), string> = Err("not here");
    fun set_mode(self, path: string, mode: i64): Result<(), string> = Ok(());
    fun sync(self, path: string): Result<(), string> = Ok(());
    fun open(self, path: string): Result<File, string> {
        let text = self.read_file(path)?;
        let (tx, lines) = Chan<string>.unbounded();
        for line of text.split("\n") {
            tx.send(line);
        }
        tx.close();
        Ok(Tape { lines: lines })
    }
    fun create(self, path: string): Result<File, string> = Err("not here");
    fun append(self, path: string): Result<File, string> = Err("not here");
    fun path(self): Result<string, string> = Ok("/memory");
}

fun save(dir: Dir): Result<(), string> {
    dir.make_dirs("a/b/c")?;
    dir.write_file("note", "first")?;
    dir.append_file("note", "\nsecond")?;
    Ok(())
}

fun main(console: Console, root: Scope) {
    let m = Memory { store: root.spawn(Store { files: Map {}, folders: [] }) };
    console.println(save(m).debug());
    console.println(m.store.made().debug());
    console.println(m.read_file("note").debug());
    let f = m.open("note").unwrap();
    console.println(f.read_line().debug());
    console.println(f.read_line().debug());
    console.println(f.read_line().debug());
    console.println(f.write_text("x").debug());
}
