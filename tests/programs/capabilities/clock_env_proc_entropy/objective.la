// The objective: a clock, the environment, a program run, randomness.
import std.random;

fun main(console: Console, clock: Clock, env: Env, proc: Proc, entropy: Entropy): i32 {
    let start = clock.monotonic_ms();
    console.println(clock.now_ms() > 0);
    console.println(env.get("HOME").is_some());
    match proc.run("echo", ["hi"]) {
        .Ok(out) => console.print(out.stdout),
        .Err(e) => console.eprintln(e),
    }
    console.println(entropy.bytes(16).len);
    let mut rng = random.from_entropy(entropy);
    console.println(rng.below(6) < 6);
    console.println(clock.monotonic_ms() >= start);
    0
}
