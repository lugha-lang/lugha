// `Env`: read-only environment variables; and the folder's path from
// `Fs`. `env.envvars` sets the two LUGHA_TEST_ variables.
fun main(console: Console, env: Env, fs: Fs) {
    console.println(env.get("LUGHA_TEST_VALUE").debug());
    console.println(env.get("LUGHA_TEST_EMPTY").debug());
    console.println(env.get("LUGHA_SURELY_UNSET_VARIABLE").debug());
    console.println(env.get("BAD\0NAME").debug());
    match fs.cwd().path() {
        .Ok(dir) => console.println(dir.starts_with("/")),
        .Err(e) => console.println("error: {e}"),
    }
    let data = env.get("LUGHA_TEST_VALUE").unwrap_or("default");
    console.println(data.char_count());
}
