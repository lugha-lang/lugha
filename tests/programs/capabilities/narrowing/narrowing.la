// Narrowing on a fake network that records what it is asked: `only` connects
// to its host at a public address it checked, by that address, with one
// lookup; private addresses only with `allow_private`; `connect_only` and
// `listen_only` refuse the other half; and `env.only` and the one-stream
// consoles.

struct Line {}

impl Conn for Line {
    fun read(self, max: i64): Result<u8[], string> = Ok([]);
    fun write(self, bytes: u8[]): Result<(), string> = Ok(());
    fun set_timeout(self, ms: i64) {}
    fun peer(self): string = "fake:1";
    fun addr(self): string = "fake:0";
    fun close(self) {}
}

struct Ear {}

impl Listener for Ear {
    fun accept(self): Result<Conn, string> = Err("nobody");
    fun addr(self): string = "fake:8080";
    fun set_timeout(self, ms: i64) {}
    fun close(self) {}
}

/** What a fake network did, owned by one task: a `Net` may cross to others. */
actor Log {
    lines: string[],
    fun add(mut self, what: string) { self.lines.push(what); }
    fun all(self): string[] = self.lines;
}

/** Names resolve as the table says; every lookup and connection is logged. */
struct Recorder { log: Log }

impl Recorder {
    fun note(self, what: string) {
        self.log.add(what);
    }
}

impl Net for Recorder {
    fun connect_timeout(self, addr: string, ms: i64): Result<Conn, string> {
        self.note("connect {addr}");
        Ok(Line {})
    }
    fun listen(self, addr: string): Result<Listener, string> {
        self.note("listen {addr}");
        Ok(Ear {})
    }
    fun resolve(self, name: string): Result<string[], string> {
        self.note("resolve {name}");
        match name {
            "api.example.com" => Ok(["10.0.0.5", "93.184.215.14"]),
            "db.internal" => Ok(["192.168.1.9", "fd00::9"]),
            "rebind.example" => Ok(["::ffff:127.0.0.1", "::ffff:10.1.2.3"]),
            _ => Err("no such host"),
        }
    }
    fun udp_bind(self, addr: string): Result<Udp, string> = Err("no udp here");
    fun udp_bind_shared(self, addr: string): Result<Udp, string> = Err("no udp here");
    fun interfaces(self): Result<NetInterface[], string> = Ok([]);
}

fun tried(console: Console, label: string, r: Result<Conn, string>) {
    match r {
        .Ok(_) => console.println("{label}: connected"),
        .Err(e) => console.println("{label}: {e}"),
    }
}

fun main(console: Console, env: Env, root: Scope) {
    let rec = Recorder { log: root.spawn(Log { lines: [] }) };
    let api = rec.only("API.Example.com:443");
    tried(console, "api", api.connect("api.example.com:443"));
    tried(console, "other host", api.connect("example.org:443"));
    tried(console, "other port", api.connect("api.example.com:80"));
    // An address of its host, checked by a fresh lookup; nothing else.
    tried(console, "by address", api.connect("93.184.215.14:443"));
    tried(console, "private address of it", api.connect("10.0.0.5:443"));
    tried(console, "not its address", api.connect("1.1.1.1:443"));
    tried(console, "its address, other port", api.connect("93.184.215.14:80"));
    tried(console, "not its v6 address", api.connect("[2606:4700::1111]:443"));
    console.println("api resolve: {api.resolve("api.example.com").debug()}");
    console.println("api listen: {api.listen(":443").is_err()} udp: {api.udp_bind("0.0.0.0:0").is_err()}");
    console.println("api resolve other: {api.resolve("example.org").debug()}");
    let db = rec.only("db.internal:5432");
    tried(console, "db", db.connect("db.internal:5432"));
    tried(console, "db allowed", db.allow_private().connect("db.internal:5432"));
    console.println("db resolve: {db.resolve("db.internal").debug()}");
    console.println("db allowed resolve: {db.allow_private().resolve("db.internal").debug()}");
    tried(console, "rebind", rec.only("rebind.example:80").connect("rebind.example:80"));
    let twice: Net = rec.only("api.example.com:443").connect_only();
    tried(console, "twice", twice.connect("api.example.com:443"));
    let out_only = rec.connect_only();
    tried(console, "connect_only", out_only.connect("anything:1"));
    console.println("connect_only listen: {out_only.listen(":80").is_err()}");
    let ears = rec.listen_only(":8080");
    console.println("listen :8080 on 0.0.0.0: {ears.listen("0.0.0.0:8080").is_ok()}");
    console.println("listen :9090: {ears.listen("0.0.0.0:9090").is_err()}");
    tried(console, "listen_only connect", ears.connect("api.example.com:443"));
    let one = rec.listen_only("127.0.0.1:8080");
    console.println("listen 0.0.0.0:8080 when 127.0.0.1 named: {one.listen("0.0.0.0:8080").is_err()}");
    for line of rec.log.all() {
        console.println("  {line}");
    }
    let lang = env.only(["LUGHA_NARROW_A"]);
    console.println("env: {lang.get("LUGHA_NARROW_A").debug()} {lang.get("LUGHA_NARROW_B").debug()}");
    let out = console.stdout_only();
    out.println("to stdout");
    out.eprintln("never shown");
    console.println("stdout_only reads: {out.read_line().debug()}");
    let err = console.stderr_only();
    err.println("never shown either");
}
