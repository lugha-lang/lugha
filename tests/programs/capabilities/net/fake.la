// A fake `Net`: its connections answer from memory, so a helper that only
// knows `Net` runs without touching the network; HTTP over it too.
import std.http;

struct Echo { said: Ref<u8[]>, closed: Ref<bool> }

impl Conn for Echo {
    fun read(self, max: i64): Result<u8[], string> {
        let got = self.said.get();
        self.said.set([]);
        Ok(got)
    }
    fun write(self, bytes: u8[]): Result<(), string> {
        self.said.set(self.said.get() + bytes);
        Ok(())
    }
    fun set_timeout(self, ms: i64) {}
    fun peer(self): string = "echo:7";
    fun addr(self): string = "here:0";
    fun close(self) {
        self.closed.set(true);
    }
}

struct Canned {}

impl Conn for Canned {
    fun read(self, max: i64): Result<u8[], string> =
        Ok("HTTP/1.1 200 OK\r\ncontent-length: 5\r\nconnection: close\r\n\r\nfaked".to_bytes());
    fun write(self, bytes: u8[]): Result<(), string> = Ok(());
    fun set_timeout(self, ms: i64) {}
    fun peer(self): string = "web:80";
    fun addr(self): string = "here:0";
    fun close(self) {}
}

struct Offline {}

impl Net for Offline {
    fun connect_timeout(self, addr: string, ms: i64): Result<Conn, string> {
        if addr.starts_with("echo") {
            return Ok(Echo { said: Ref.new([]), closed: Ref.new(false) });
        }
        if addr.starts_with("web") {
            return Ok(Canned {});
        }
        Err("offline: {addr}")
    }
    fun listen(self, addr: string): Result<Listener, string> = Err("offline");
    fun resolve(self, name: string): Result<string[], string> = Ok(["10.0.0.1"]);
    fun udp_bind(self, addr: string): Result<Udp, string> = Err("offline");
    fun udp_bind_shared(self, addr: string): Result<Udp, string> = Err("offline");
    fun interfaces(self): Result<NetInterface[], string> =
        Ok([NetInterface { name: "fake0", index: 1, up: true, multicast: false, addresses: ["10.0.0.1"] }]);
}

fun ask(net: Net, addr: string, what: string): Result<string, string> {
    let c = net.connect(addr)?;
    c.write(what.to_bytes())?;
    let back = string_from_utf8(c.read(64)?)?;
    c.close();
    Ok(back)
}

fun main(console: Console) {
    let net = Offline {};
    console.println(ask(net, "echo:7", "hello").debug());
    console.println(ask(net, "example.com:80", "hello").debug());
    console.println(net.resolve("anything").debug());
    console.println(net.interfaces().unwrap()[0].name);
    match http.get(net, "http://web/page") {
        .Ok(r) => console.println("{r.status} {r.text().unwrap()}"),
        .Err(e) => console.println(e),
    }
}
