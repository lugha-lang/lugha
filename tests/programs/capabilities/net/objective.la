// The objective: listening, connecting and name lookup through a `Net`.
fun main(console: Console, net: Net, root: Scope): i32 {
    let server = net.listen("127.0.0.1:0").unwrap();
    root.spawn(serve_one(server));
    let c = net.connect(server.addr()).unwrap();
    let w = c.write("ping".to_bytes());
    console.println(string_from_utf8(c.read(16).unwrap()).unwrap());
    c.close();
    console.println(net.resolve("127.0.0.1").debug());
    0
}

fun serve_one(l: Listener) {
    let c = l.accept().unwrap();
    let got = c.read(16).unwrap();
    let w = c.write("pong".to_bytes());
    c.close();
    l.close();
}
