// if let, while let and let … else.

enum Token { Num(i64), Word(string), Space, End }

fun describe(t: Token): string {
    if let .Num(n) = t {
        "number {n}"
    } else if let .Word(w) = t {
        "word {w}"
    } else if let .Space | .End = t {
        "blank"
    } else {
        "other"
    }
}

fun sum_positive(xs: i64[]): i64 {
    let mut total = 0;
    for x of xs {
        let 0 = x % 2 else {
            continue;
        };
        total += x;
    }
    total
}

fun main(console: Console) {
    console.println(describe(Token.Num(4)));
    console.println(describe(Token.Word("hi")));
    console.println(describe(Token.Space));
    console.println(describe(Token.End));

    // `if let` as a value
    let n = if let .Some(v) = parse_i64("12") { v } else { 0 };
    console.println(n * 2);

    // while let with break and continue
    let mut stack = [1, 2, 3, 4, 5, 6];
    let mut seen = 0;
    while let .Some(top) = stack.pop() {
        if top == 5 {
            continue;
        }
        if top == 2 {
            break;
        }
        seen += top;
    }
    console.println("{seen} {stack.len}");

    // mut in while let
    let mut pairs = [Some(1), None, Some(3)];
    while let .Some(slot) = pairs.pop() {
        if let .Some(mut v) = slot {
            v *= 10;
            console.print("{v} ");
        } else {
            console.print("_ ");
        }
    }
    console.println("");

    console.println(sum_positive([1, 2, 3, 4]));
    let .End = Token.End else {
        console.println("not the end");
        return;
    };
    console.println("end");
}
