// Deep == and string order.
struct Item { name: string, tags: string[], counts: i64[][], ok: bool } with Eq

enum Shape { Circle(f64), Rect(f64, f64), Empty } with Eq

enum List { Nil, Cons(i64, List) } with Eq

fun list(n: i64): List {
    let mut l = List.Nil;
    for i in 0..n { l = List.Cons(i, l); }
    l
}

fun main(console: Console) {
    // Structs: field by field, through arrays and strings.
    let a = Item { name: "x", tags: ["t", "u"], counts: [[1, 2], [3]], ok: true };
    let mut b = a;
    console.println(a == b);
    b.counts[1].push(4);
    console.println(a == b);
    console.println(a != b);
    let mut c = a;
    c.ok = false;
    console.println(a == c);

    // Arrays: length, then elements.
    console.println([[1, 2], [3]] == [[1, 2], [3]]);
    console.println([1, 2] == [1, 2, 3]);
    console.println([1, 2] == [1, 3]);
    let empty: i64[] = [];
    console.println(empty == []);

    // Enums: variant, then payloads; recursive ones too.
    console.println(Shape.Rect(1.0, 2.0) == Shape.Rect(1.0, 2.0));
    console.println(Shape.Rect(1.0, 2.0) == Shape.Rect(2.0, 1.0));
    console.println(Shape.Circle(1.0) == Shape.Empty);
    console.println(Shape.Empty == Shape.Empty);
    console.println(list(5) == list(5));
    console.println(list(5) == list(4));

    // Option, from either side.
    let o: Option<string> = Some("a");
    console.println(o == None);
    console.println(None == o);
    console.println(o == Some("a"));

    // NaN is unequal to itself, even inside an array.
    let nan = 0.0 / 0.0;
    let xs = [1.0, nan];
    console.println(xs == xs);
    console.println(xs != xs);

    // Strings order bytewise; a prefix is smaller; bytes are unsigned.
    console.println("ab" < "abc");
    console.println("abc" < "ab");
    console.println("b" > "abc");
    console.println("a" <= "a");
    console.println("é" > "z");
    console.println("Z" < "a");
}
