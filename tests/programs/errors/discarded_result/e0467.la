// A `Result` dropped as a statement is E0467; `let _ =` drops one on purpose.

fun save(text: string): Result<(), string> {
    if text == "" {
        return Err("nothing to save");
    }
    Ok(())
}

fun main(console: Console, files: Fs) {
    save("draft");                       // E0467: this `Result` is discarded
    let _ = save("draft");               // a deliberate discard
    match save("") {
        .Ok(()) => console.println("saved"),
        .Err(e) => console.println("not saved: {e}"),
    }
    defer {
        let _ = files.cwd().remove_file("tmp.txt");   // a discard inside `defer`'s braces
    };
}
