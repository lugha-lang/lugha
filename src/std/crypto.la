/**
 * std.crypto: SHA-256, Ed25519 signatures (RFC 8032), random bytes,
 * constant-time comparison, HKDF-SHA256 (RFC 5869), ChaCha20-Poly1305
 * sealing (RFC 8439), X25519 key exchange (RFC 7748) and HPKE, sealing to
 * a public key (RFC 9180), through the
 * system's OpenSSL (3.2 or newer). Keys, signatures and digests are plain bytes: a
 * 32-byte secret seed, a 32-byte public key, a 64-byte signature, a 32-byte
 * digest. Nothing here panics on any input; mistakes come back as
 * `CryptoError` (or `false`, from `ed25519_verify` and `equal`).
 *
 * Secrets: the C side wipes its own copies, and OpenSSL clears its key
 * objects. A secret seed handed to your program, and every copy you make of
 * it, lives in collected memory, which Lugha can't wipe yet.
 *
 * A program that uses this module is linked with OpenSSL (`libssl-dev` must
 * be installed to build it).
 */

/** Why a cryptographic operation didn't happen. */
public enum CryptoError {
    /** What had the wrong length, the length wanted, the length given. */
    BadLength(string, i64, i64),
    /** OpenSSL failed, with its reason. */
    OpenSsl(string),
    /**
     * Opening refused sealed bytes: they, their nonce or their associated
     * data were changed, or the key is wrong. No plaintext comes back.
     */
    NotAuthentic,
    /** A key that mustn't be used, and why: a low-order X25519 peer key. */
    BadKey(string),
} with Eq

impl CryptoError {
    /** The error as a sentence. */
    public fun message(self): string {
        match self {
            BadLength(what, wanted, given) => "{what}: wanted {wanted} bytes, got {given}",
            OpenSsl(reason) => "OpenSSL: {reason}",
            NotAuthentic => "the sealed bytes don't match their key, nonce and associated data",
            BadKey(why) => "bad key: {why}",
        }
    }
}

/**
 * The SHA-256 digest of some bytes.
 * @param bytes what to hash
 * @returns 32 bytes
 */
public fun sha256(bytes: u8[]): u8[] = $os.crypto_sha256(bytes);

/**
 * A SHA-256 hash fed in pieces, so a large input needn't be one array:
 * `Sha256.new()`, `update` as often as needed, then `finish`. Copies share
 * one running hash. Nothing needs closing.
 */
public struct Sha256 {
    state: CPtr,
}

impl Sha256 {
    /** An empty hash. */
    public fun new(): Sha256 = Sha256 { state: $os.crypto_sha256_new() };

    /**
     * Feeds more bytes.
     * @param bytes the next piece
     */
    public fun update(self, bytes: u8[]) {
        $os.crypto_sha256_update(self.state, bytes);
    }

    /**
     * The digest of everything fed so far; the hash then starts over, empty.
     * @returns 32 bytes
     */
    public fun finish(self): u8[] = $os.crypto_sha256_finish(self.state);
}

/**
 * A new Ed25519 key pair from OpenSSL's random generator.
 * @returns `(secret, key)`: the 32-byte secret seed and its 32-byte public key
 */
public fun ed25519_keypair(): Result<(u8[], u8[]), CryptoError> {
    let secret = $os.crypto_seed().map_err(failed)?;
    let key = ed25519_public(secret)?;
    Ok((secret, key))
}

/**
 * The public key of a secret seed.
 * @param secret the 32-byte secret seed
 * @returns the 32-byte public key
 */
public fun ed25519_public(secret: u8[]): Result<u8[], CryptoError> {
    sized(secret, "secret key", 32)?;
    $os.crypto_ed25519_public(secret).map_err(failed)
}

/**
 * Signs a message (Ed25519 hashes it itself).
 * @param secret the 32-byte secret seed
 * @param message what to sign
 * @returns the 64-byte signature
 */
public fun ed25519_sign(secret: u8[], message: u8[]): Result<u8[], CryptoError> {
    sized(secret, "secret key", 32)?;
    $os.crypto_ed25519_sign(secret, message).map_err(failed)
}

/**
 * Whether `signature` is `key`'s signature of `message`: `false` for
 * anything wrong, wrong lengths and malformed keys included.
 * @param key the 32-byte public key
 * @param message what was signed
 * @param signature the 64-byte signature
 */
public fun ed25519_verify(key: u8[], message: u8[], signature: u8[]): bool {
    if key.len != 32 || signature.len != 64 {
        return false;
    }
    $os.crypto_ed25519_verify(key, message, signature) == 1
}

/**
 * Bytes from OpenSSL's cryptographically secure random generator.
 * @param n how many, from 0 to 1048576
 */
public fun random_bytes(n: i64): Result<u8[], CryptoError> {
    if n < 0 || n > 1048576 {
        return Err(CryptoError.BadLength("random bytes (at most)", 1048576, n));
    }
    $os.crypto_random(n).map_err(failed)
}

/**
 * Whether two byte arrays are equal, in time that depends only on their
 * length: for comparing secrets, digests and tags. `false` at once for
 * different lengths.
 */
public fun equal(a: u8[], b: u8[]): bool = a.len == b.len && $os.crypto_equal(a, b) == 1;

/**
 * HKDF-SHA256 (RFC 5869): extract then expand, deriving `length` bytes of
 * key material from `key`. Different `info` gives independent keys from
 * one secret.
 * @param key the input key material (a secret)
 * @param salt optional randomness; empty means RFC 5869's default
 * @param info what the key is for; may be empty
 * @param length how many bytes, from 1 to 8160 (255 × 32)
 */
public fun hkdf_sha256(key: u8[], salt: u8[], info: u8[], length: i64): Result<u8[], CryptoError> {
    if length < 1 || length > 8160 {
        return Err(CryptoError.BadLength("HKDF length (from 1 to)", 8160, length));
    }
    $os.crypto_hkdf(key, salt, info, length).map_err(failed)
}

/**
 * Seals bytes with ChaCha20-Poly1305 (RFC 8439): encrypts `plaintext` and
 * authenticates it together with `aad`, which is sent as it is. Never seal
 * two messages with the same key and nonce: that reveals both. A nonce from
 * `random_bytes(12)` is safe for up to about 4 billion messages per key.
 * @param key 32 secret bytes
 * @param nonce 12 bytes, never used before with this key
 * @param plaintext what to seal, at most 1073741824 bytes
 * @param aad associated data: authenticated, not encrypted; may be empty
 * @returns the ciphertext with the 16-byte tag appended
 */
public fun chacha20poly1305_seal(key: u8[], nonce: u8[], plaintext: u8[], aad: u8[]): Result<u8[], CryptoError> {
    sized(key, "key", 32)?;
    sized(nonce, "nonce", 12)?;
    at_most(plaintext, "plaintext")?;
    at_most(aad, "associated data")?;
    $os.crypto_seal(key, nonce, plaintext, aad).map_err(failed)
}

/**
 * Opens what `chacha20poly1305_seal` sealed: the plaintext if the tag
 * matches `key`, `nonce` and `aad`, otherwise `NotAuthentic` and no
 * plaintext at all.
 * @param key the 32 bytes it was sealed with
 * @param nonce the 12 bytes it was sealed with
 * @param sealed ciphertext then tag: at least 16 bytes
 * @param aad the associated data it was sealed with
 */
public fun chacha20poly1305_open(key: u8[], nonce: u8[], sealed: u8[], aad: u8[]): Result<u8[], CryptoError> {
    sized(key, "key", 32)?;
    sized(nonce, "nonce", 12)?;
    if sealed.len < 16 {
        return Err(CryptoError.BadLength("sealed bytes (at least)", 16, sealed.len));
    }
    at_most(sealed, "sealed bytes")?;
    at_most(aad, "associated data")?;
    $os.crypto_open(key, nonce, sealed, aad).map_err(failed)
}

/**
 * A new X25519 key pair from OpenSSL's random generator.
 * @returns `(secret, key)`: 32 secret bytes and the 32-byte public key
 */
public fun x25519_keypair(): Result<(u8[], u8[]), CryptoError> {
    let secret = $os.crypto_seed().map_err(failed)?;
    let key = x25519_public(secret)?;
    Ok((secret, key))
}

/**
 * The X25519 public key of a secret (any 32 bytes are one).
 * @param secret 32 secret bytes
 * @returns the 32-byte public key
 */
public fun x25519_public(secret: u8[]): Result<u8[], CryptoError> {
    sized(secret, "secret key", 32)?;
    $os.crypto_x25519_public(secret).map_err(failed)
}

/**
 * The secret two X25519 key pairs share (RFC 7748): `x25519_shared(a, B)`
 * equals `x25519_shared(b, A)`. Derive keys from it with `hkdf_sha256`
 * rather than using it as a key itself. A low-order peer key, which would
 * make the result all zeros, is `BadKey`.
 * @param secret your 32 secret bytes
 * @param peer_public the other side's 32-byte public key
 * @returns 32 shared bytes
 */
public fun x25519_shared(secret: u8[], peer_public: u8[]): Result<u8[], CryptoError> {
    sized(secret, "secret key", 32)?;
    sized(peer_public, "peer public key", 32)?;
    $os.crypto_x25519_shared(secret, peer_public).map_err(failed)
}

/**
 * Seals bytes to an X25519 public key with HPKE (RFC 9180, base mode):
 * only the holder of its secret can open them, and nobody learns who
 * sealed them (sign the bytes with Ed25519 if that matters). Each seal
 * uses a fresh one-time key, so there is no nonce to manage. The suite is
 * fixed: DHKEM(X25519, HKDF-SHA256), HKDF-SHA256, ChaCha20-Poly1305.
 * @param key the recipient's 32-byte X25519 public key
 * @param info what the sealing is for, bound into the keys; at most 1024 bytes, may be empty
 * @param plaintext what to seal, from 1 to 1073741824 bytes (OpenSSL's HPKE refuses an empty one)
 * @param aad associated data: authenticated, not encrypted; may be empty
 * @returns the 32-byte encapsulated key, then the ciphertext with its 16-byte tag
 */
public fun hpke_seal(key: u8[], info: u8[], plaintext: u8[], aad: u8[]): Result<u8[], CryptoError> {
    sized(key, "public key", 32)?;
    hpke_info(info)?;
    if plaintext.len == 0 {
        return Err(CryptoError.BadLength("plaintext (at least)", 1, 0));
    }
    at_most(plaintext, "plaintext")?;
    at_most(aad, "associated data")?;
    $os.crypto_hpke_seal(key, info, plaintext, aad).map_err(failed)
}

/**
 * Opens what `hpke_seal` sealed: the plaintext if `secret`, `info` and
 * `aad` match, otherwise `NotAuthentic` and no plaintext at all.
 * @param secret the recipient's 32 secret X25519 bytes
 * @param info what it was sealed with
 * @param sealed encapsulated key, ciphertext and tag: at least 49 bytes
 * @param aad what it was sealed with
 */
public fun hpke_open(secret: u8[], info: u8[], sealed: u8[], aad: u8[]): Result<u8[], CryptoError> {
    sized(secret, "secret key", 32)?;
    hpke_info(info)?;
    if sealed.len < 49 {
        return Err(CryptoError.BadLength("sealed bytes (at least)", 49, sealed.len));
    }
    at_most(sealed, "sealed bytes")?;
    at_most(aad, "associated data")?;
    $os.crypto_hpke_open(secret, info, sealed, aad).map_err(failed)
}

fun hpke_info(info: u8[]): Result<(), CryptoError> {
    if info.len <= 1024 { Ok(()) } else { Err(CryptoError.BadLength("info (at most)", 1024, info.len)) }
}

// The runtime's fixed messages for a wrong tag and a low-order peer key
// become their own variants; every other message is OpenSSL's.
fun failed(reason: string): CryptoError {
    if reason == "not authentic" {
        CryptoError.NotAuthentic
    } else if reason == "low order" {
        CryptoError.BadKey("the peer's public key has low order")
    } else {
        CryptoError.OpenSsl(reason)
    }
}

fun at_most(bytes: u8[], what: string): Result<(), CryptoError> {
    if bytes.len <= 1073741824 {
        Ok(())
    } else {
        Err(CryptoError.BadLength("{what} (at most)", 1073741824, bytes.len))
    }
}

fun sized(bytes: u8[], what: string, wanted: i64): Result<(), CryptoError> {
    if bytes.len == wanted { Ok(()) } else { Err(CryptoError.BadLength(what, wanted, bytes.len)) }
}
