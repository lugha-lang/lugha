/**
 * std.tls: TLS over any `Conn`, through the system's OpenSSL (3.2 or
 * newer). Every certificate is verified — its chain against the system's
 * trusted roots and the host name — and nothing turns that off:
 * `Options.ca_pem` adds certificates to trust (a private CA, or a
 * self-signed certificate). TLS 1.2 is the oldest version spoken.
 *
 * Connections by key (`listen_keys`, `connect_keys`) use no certificates:
 * each side proves an Ed25519 key, and each accepts only the keys on its
 * list, checked in the handshake. They speak TLS 1.3 only, which keeps the
 * client's key hidden from the network.
 *
 * OpenSSL works on memory buffers and this module carries the bytes over
 * the `Conn` underneath, so TLS runs over whatever a `Net` gives, a fake
 * one included: `connect` and `listen` go through the `Net`, and `client`
 * and `server` wrap a connection made any other way. Certificates and keys
 * are PEM text, read by the caller (through a `Dir`): this module reads no
 * file but the system's trusted roots.
 *
 * A program that uses this module is linked with OpenSSL (`libssl-dev`
 * must be installed to build it). Close what you open, as with a `Conn`.
 */

/** How to connect: `options()` gives the defaults. */
public struct Options {
    /** PEM text of certificates to trust besides the system's; `""` for none. */
    public ca_pem: string,
    /** Milliseconds a connect, handshake, read or write may wait; `0` waits forever. */
    public timeout_ms: i64,
    /**
     * An IP address to connect to instead of resolving the host (`""`
     * resolves it, like curl's `--resolve`); the certificate must still
     * name the host.
     */
    public address: string,
}

/** The defaults: the system's roots only, no timeout. */
public fun options(): Options = Options { ca_pem: "", timeout_ms: 0, address: "" };

/**
 * This side's key and the keys it accepts, for connections by key: Ed25519
 * keys as `std.crypto` makes them.
 */
public struct Keys {
    /** This side's 32-byte Ed25519 secret seed. */
    public secret: u8[],
    /** The 32-byte public keys of the peers accepted; empty accepts nobody. */
    public accept: u8[][],
}

/** An encrypted connection over another `Conn`; it is a `Conn` itself. */
public struct SecureConn {
    h: Ref<i64>,
    under: Conn,
    timeout: Ref<i64>,
}

/** A listener whose connections are encrypted; it is a `Listener` itself. */
public struct SecureListener {
    ctx: Ref<i64>,
    under: Listener,
    timeout: Ref<i64>,
}

/**
 * Connects and verifies the server's certificate for the address's host.
 * @param net the network to connect through
 * @param addr host:port, `example.com:443`
 * @returns the connection, or `Err` with the reason (`certificate verify failed: …`)
 */
public fun connect(net: Net, addr: string): Result<SecureConn, string> = connect_with(net, addr, options());

/**
 * `connect` with options: certificates to trust, a timeout, an address to
 * connect to (`addr`'s host still verified).
 * @param net the network to connect through
 * @param addr host:port
 * @param opts what to trust and how long to wait
 */
public fun connect_with(net: Net, addr: string, opts: Options): Result<SecureConn, string> {
    let target = if opts.address == "" { addr } else { at(opts.address, port_of(addr))? };
    let conn = net.connect_timeout(target, opts.timeout_ms)?;
    client(conn, host_of(addr), opts)
}

/**
 * Connects by key: the server must prove one of `keys.accept`'s keys
 * (otherwise `Err("peer key not accepted")`), and this side proves its
 * own. No host name is checked: `addr` is only where to connect. A server
 * that refuses this side's key does so after the handshake has finished
 * here, so it shows as the first read failing.
 * @param net the network to connect through
 * @param addr host:port or ip:port
 * @param keys this side's secret and the servers' public keys
 * @param timeout_ms how long the connect and handshake, and later reads and writes, may wait; `0` waits forever
 */
public fun connect_keys(net: Net, addr: string, keys: Keys, timeout_ms: i64): Result<SecureConn, string> {
    sized(keys)?;
    let conn = net.connect_timeout(addr, timeout_ms)?;
    client_keys(conn, keys, timeout_ms)
}

/**
 * TLS as the client over a connection made any way, verifying the server's
 * certificate for `host`. On failure the connection is closed.
 * @param conn the connection underneath
 * @param host the name (or IP address) the certificate must show
 * @param opts what to trust and how long to wait (`address` is not used)
 */
public fun client(conn: Conn, host: string, opts: Options): Result<SecureConn, string> {
    let ctx = match $os.tls_client_context(opts.ca_pem) {
        .Ok(c) => c,
        .Err(e) => {
            conn.close();
            return Err(e);
        }
    };
    let made = $os.tls_new(ctx, host);
    // The connection keeps its own reference to OpenSSL's context.
    $os.tls_free_context(ctx);
    started(made, conn, opts.timeout_ms)
}

/**
 * `client` by key, as `connect_keys`, over a connection made any way. On
 * failure the connection is closed.
 * @param conn the connection underneath
 * @param keys this side's secret and the servers' public keys
 * @param timeout_ms how long the handshake, and later reads and writes, may wait; `0` waits forever
 */
public fun client_keys(conn: Conn, keys: Keys, timeout_ms: i64): Result<SecureConn, string> {
    if let .Err(e) = sized(keys) {
        conn.close();
        return Err(e);
    }
    let ctx = match $os.tls_key_context(0, keys.secret, keys.accept) {
        .Ok(c) => c,
        .Err(e) => {
            conn.close();
            return Err(e);
        }
    };
    let made = $os.tls_new(ctx, "");
    $os.tls_free_context(ctx);
    started(made, conn, timeout_ms)
}

/**
 * TLS as the server over one connection made any way (`listen` does this
 * for each connection it accepts). On failure the connection is closed.
 * @param conn the connection underneath
 * @param cert_pem the certificate chain, PEM text, the server's first
 * @param key_pem its private key, PEM text, unencrypted
 */
public fun server(conn: Conn, cert_pem: string, key_pem: string): Result<SecureConn, string> {
    let ctx = match $os.tls_server_context(cert_pem, key_pem) {
        .Ok(c) => c,
        .Err(e) => {
            conn.close();
            return Err(e);
        }
    };
    let made = $os.tls_new(ctx, "");
    $os.tls_free_context(ctx);
    started(made, conn, 0)
}

/**
 * Listens for TLS connections with a certificate and its private key.
 * @param net the network to listen through
 * @param addr host:port
 * @param cert_pem the certificate chain, PEM text, the server's first
 * @param key_pem its private key, PEM text, unencrypted
 */
public fun listen(net: Net, addr: string, cert_pem: string, key_pem: string): Result<SecureListener, string> {
    let ctx = $os.tls_server_context(cert_pem, key_pem)?;
    listening(net, addr, ctx)
}

/**
 * Listens for connections by key: a client gets in only by proving one of
 * `keys.accept`'s keys (a client without one, or with a certificate, is
 * refused in the handshake). `set_accept` changes the list later.
 * @param net the network to listen through
 * @param addr host:port
 * @param keys this side's secret and the clients' public keys
 */
public fun listen_keys(net: Net, addr: string, keys: Keys): Result<SecureListener, string> {
    sized(keys)?;
    let ctx = $os.tls_key_context(1, keys.secret, keys.accept)?;
    listening(net, addr, ctx)
}

/** A listener on `addr` handing each connection to context `ctx`, freed if listening fails. */
fun listening(net: Net, addr: string, ctx: i64): Result<SecureListener, string> {
    match net.listen(addr) {
        .Ok(l) => Ok(SecureListener { ctx: Ref.new(ctx), under: l, timeout: Ref.new(0) }),
        .Err(e) => {
            $os.tls_free_context(ctx);
            Err(e)
        }
    }
}

/** A new connection `made` over `conn`, after its handshake; both freed on failure. */
fun started(made: Result<i64, string>, conn: Conn, timeout_ms: i64): Result<SecureConn, string> {
    let h = match made {
        .Ok(h) => h,
        .Err(e) => {
            conn.close();
            return Err(e);
        }
    };
    match drive(h, conn, 0, [], 0, deadline(timeout_ms)) {
        .Ok(_) => Ok(SecureConn { h: Ref.new(h), under: conn, timeout: Ref.new(timeout_ms) }),
        .Err(e) => {
            $os.tls_free(h);
            conn.close();
            Err(e)
        }
    }
}

/** `bytes[from..to]` as a new array. */
fun part(bytes: u8[], from: i64, to: i64): u8[] {
    let mut out: u8[] = [];
    for i in from..to {
        out.push(bytes[i]);
    }
    out
}

/** When an operation allowed `ms` must end, on the runtime's clock; `0` never. */
fun deadline(ms: i64): i64 = if ms > 0 { $os.now_ms() + ms } else { 0 };

/** Sets the connection underneath to wait until `until` (`0` forever); `Err` once it has passed. */
fun until(conn: Conn, until: i64): Result<(), string> {
    if until == 0 {
        conn.set_timeout(0);
        return Ok(());
    }
    let left = until - $os.now_ms();
    if left <= 0 {
        return Err("timed out");
    }
    conn.set_timeout(left);
    Ok(())
}

/** Sends whatever OpenSSL has written for the peer. */
fun flush_out(h: i64, conn: Conn, by: i64): Result<(), string> {
    let out = $os.tls_outgoing(h);
    if out.len > 0 {
        until(conn, by)?;
        conn.write(out)?;
    }
    Ok(())
}

/**
 * Steps OpenSSL until operation `op` finishes (0 the handshake, 1 a read of
 * up to `max` bytes, 2 a write of `data`, 3 close_notify), carrying bytes
 * both ways over `conn` by `by`.
 */
fun drive(h: i64, conn: Conn, op: i64, data: u8[], max: i64, by: i64): Result<u8[], string> {
    loop {
        let step = $os.tls_step(h, op, data, max);
        // Even a failed step may have an alert for the peer.
        let sent = flush_out(h, conn, by);
        let (done, bytes) = step?;
        sent?;
        if done == 1 {
            return Ok(bytes);
        }
        until(conn, by)?;
        let more = conn.read(65536)?;
        if more.len == 0 {
            $os.tls_incoming_end(h);
        } else {
            $os.tls_incoming(h, more);
        }
    }
}

/** The lengths `$os` would refuse, checked first with the same messages. */
fun sized(keys: Keys): Result<(), string> {
    if keys.secret.len != 32 {
        return Err("secret key must be 32 bytes");
    }
    accepted(keys.accept)
}

fun accepted(accept: u8[][]): Result<(), string> {
    for i in 0..accept.len {
        if accept[i].len != 32 {
            return Err("accepted key {i} must be 32 bytes");
        }
    }
    Ok(())
}

/** `address`, which must be an IP literal, at `port`, with an IPv6 address in brackets. */
fun at(address: string, port: string): Result<string, string> {
    let ip = match $os.net_resolve(address, 1) {
        .Ok(ip) => ip,
        .Err(_) => {
            return Err("address must be an IP address: {address}");
        }
    };
    Ok(if ip.contains(":") { "[{ip}]:{port}" } else { "{ip}:{port}" })
}

/** What follows `addr`'s last `:`; `""` with none. */
fun port_of(addr: string): string {
    let parts = addr.split(":");
    if parts.len < 2 { "" } else { parts[parts.len - 1] }
}

/** The host a certificate must name: `addr` without its port and brackets. */
fun host_of(addr: string): string {
    let mut colon = -1;
    let raw = addr.to_bytes();
    for i in 0..raw.len {
        if raw[i] == 58 {
            colon = i;
        }
    }
    let host = if colon < 0 { addr } else { addr.slice(0, colon) };
    if host.starts_with("[") && host.ends_with("]") && host.len > 2 { host.slice(1, host.len - 1) } else { host }
}

impl Listener for SecureListener {
    /** The next connection, after its handshake; only this green thread waits. A failed handshake is an `Err`. */
    fun accept(self): Result<Conn, string> {
        let secure = self.accept_secure()?;
        Ok(secure)
    }

    fun addr(self): string = if self.ctx.get() < 0 { "" } else { self.under.addr() };

    /** How long `accept` with its handshake waits, in milliseconds; `0` waits forever. */
    fun set_timeout(self, ms: i64) {
        self.timeout.set(ms);
        self.under.set_timeout(ms);
    }

    fun close(self) {
        let ctx = self.ctx.get();
        if ctx >= 0 {
            self.ctx.set(-1);
            self.under.close();
            $os.tls_free_context(ctx);
        }
    }
}

impl SecureListener {
    /**
     * `accept`, giving the connection as a `SecureConn`, for its `peer_key()`.
     * @returns the connection after its handshake, or `Err` (a failed handshake is one too)
     */
    public fun accept_secure(self): Result<SecureConn, string> {
        let ctx = self.ctx.get();
        if ctx < 0 {
            return Err("closed");
        }
        let conn = self.under.accept()?;
        started($os.tls_new(ctx, ""), conn, self.timeout.get())
    }

    /**
     * Replaces the keys a listener by key accepts, for connections accepted
     * from now on.
     * @param accept the 32-byte public keys; empty accepts nobody
     * @returns `Ok(())`, or `Err` for a certificate listener or a closed one
     */
    public fun set_accept(self, accept: u8[][]): Result<(), string> {
        let ctx = self.ctx.get();
        if ctx < 0 {
            return Err("closed");
        }
        accepted(accept)?;
        $os.tls_set_accept(ctx, accept)?;
        Ok(())
    }
}

impl Conn for SecureConn {
    fun read(self, max: i64): Result<u8[], string> {
        let h = self.h.get();
        if h < 0 {
            return Err("closed");
        }
        drive(h, self.under, 1, [], max, deadline(self.timeout.get()))
    }

    fun write(self, bytes: u8[]): Result<(), string> {
        let h = self.h.get();
        if h < 0 {
            return Err("closed");
        }
        let by = deadline(self.timeout.get());
        let mut at = 0;
        while at < bytes.len {
            // One record at a time keeps OpenSSL's output buffer small.
            let end = if bytes.len - at > 16384 { at + 16384 } else { bytes.len };
            drive(h, self.under, 2, part(bytes, at, end), 0, by)?;
            at = end;
        }
        Ok(())
    }

    fun set_timeout(self, ms: i64) {
        self.timeout.set(ms);
    }

    fun peer(self): string = if self.h.get() < 0 { "" } else { self.under.peer() };

    fun addr(self): string = if self.h.get() < 0 { "" } else { self.under.addr() };

    /** Ends the connection, telling the other end without waiting for its reply, and closes every copy. */
    fun close(self) {
        let h = self.h.get();
        if h >= 0 {
            self.h.set(-1);
            // Best effort: the peer may be gone already.
            if let .Ok(_) = $os.tls_step(h, 3, [], 0) {
                let _ = flush_out(h, self.under, deadline(1000));
            }
            $os.tls_free(h);
            self.under.close();
        }
    }
}

impl SecureConn {
    /**
     * The 32-byte Ed25519 key the other end proved, on a connection by key;
     * `[]` on a certificate connection and once closed.
     */
    public fun peer_key(self): u8[] {
        let h = self.h.get();
        if h < 0 { [] } else { $os.tls_peer_key(h) }
    }
}
