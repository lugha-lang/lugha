// The real capabilities: the runtime's, reached through the intrinsics and
// `$os` built-ins only the prelude and std may call.

/** The real console: the process's standard streams. */
struct $Console {}

impl Console for $Console {
    fun print(self, x: Display) { print(x.show()); }
    fun println(self, x: Display) { println(x.show()); }
    fun eprint(self, x: Display) { eprint(x.show()); }
    fun eprintln(self, x: Display) { eprintln(x.show()); }
    fun read_line(self): Result<Option<string>, string> = match read_line()? {
        .Some((n, bytes)) => match string_from_utf8(bytes) {
            .Ok(line) => Ok(Some(line)),
            .Err(_) => Err("line {n} is not valid UTF-8"),
        },
        .None => Ok(None),
    };
    fun read_bytes(self): Result<u8[], string> = read_stdin_bytes();
    fun flush(self) { flush(); }
}

/** The real file system. */
struct $Fs {}

impl Fs for $Fs {
    fun cwd(self): Dir = match $os.dir_cwd() {
        .Ok(h) => $Dir { h: h, read_only: false },
        // Only when the working folder was deleted or made unreadable before the program ran.
        .Err(e) => panic("can't open the working folder: {e}"),
    };
    fun dir(self, path: string): Result<Dir, string> {
        let h = $os.dir_open(path)?;
        Ok($Dir { h: h, read_only: false })
    }
}

/**
 * A real folder: a directory descriptor, every path opened beneath it by
 * the kernel (`openat2`, `RESOLVE_BENEATH`); `read_only` refuses writing
 * before any system call.
 */
struct $Dir { h: $Resource, read_only: bool }

impl Dir for $Dir {
    fun dir(self, path: string): Result<Dir, string> {
        let h = $os.dir_sub(self.h, path)?;
        Ok($Dir { h: h, read_only: self.read_only })
    }
    fun read_only(self): Dir = $Dir { h: self.h, read_only: true };
    fun read_file(self, path: string): Result<string, string> = $os.dir_read_text(self.h, path);
    fun read_bytes(self, path: string): Result<u8[], string> = $os.dir_read_bytes(self.h, path);
    fun write_bytes(self, path: string, bytes: u8[]): Result<i64, string> {
        self.writable()?;
        $os.dir_write(self.h, path, bytes, 0)
    }
    fun append_bytes(self, path: string, bytes: u8[]): Result<i64, string> {
        self.writable()?;
        $os.dir_write(self.h, path, bytes, 1)
    }
    fun list(self, path: string): Result<string[], string> {
        let raw = $os.dir_list(self.h, path)?;
        let mut names: string[] = [];
        for bytes of raw {
            match string_from_utf8(bytes) {
                .Ok(name) => names.push(name),
                .Err(_) => {
                    return Err("a name in {path} is not valid UTF-8");
                }
            }
        }
        Ok(names.sort())
    }
    fun make_dir(self, path: string): Result<(), string> {
        self.writable()?;
        $os.dir_make(self.h, path)?;
        Ok(())
    }
    fun remove_file(self, path: string): Result<(), string> {
        self.writable()?;
        $os.dir_remove(self.h, path, 0)?;
        Ok(())
    }
    fun remove_dir(self, path: string): Result<(), string> {
        self.writable()?;
        $os.dir_remove(self.h, path, 1)?;
        Ok(())
    }
    fun exists(self, path: string): bool = $os.dir_kind(self.h, path) != 0;
    fun is_dir(self, path: string): bool = $os.dir_kind(self.h, path) == 2;
    fun is_file(self, path: string): bool = $os.dir_kind(self.h, path) == 1;
    fun size(self, path: string): Result<i64, string> = $os.dir_size(self.h, path);
    fun rename(self, from: string, to: string): Result<(), string> {
        self.writable()?;
        $os.dir_rename(self.h, from, to)?;
        Ok(())
    }
    fun set_mode(self, path: string, mode: i64): Result<(), string> {
        self.writable()?;
        $os.dir_chmod(self.h, path, mode)?;
        Ok(())
    }
    fun sync(self, path: string): Result<(), string> {
        $os.dir_sync(self.h, path)?;
        Ok(())
    }
    fun open(self, path: string): Result<File, string> = $opened(self.h, path, 0);
    fun create(self, path: string): Result<File, string> {
        self.writable()?;
        $opened(self.h, path, 1)
    }
    fun append(self, path: string): Result<File, string> {
        self.writable()?;
        $opened(self.h, path, 2)
    }
    fun path(self): Result<string, string> {
        let bytes = $os.dir_path(self.h)?;
        string_from_utf8(bytes)
    }
}

impl $Dir {
    /** `Err` for a read-only folder, before anything is touched. */
    fun writable(self): Result<(), string> = if self.read_only { Err("the folder is read-only") } else { Ok(()) };
}

/** A file opened beneath folder `h` in `mode` 0 (reading), 1 (creating) or 2 (appending). */
fun $opened(h: $Resource, path: string, mode: i64): Result<File, string> {
    let fd = $os.dir_file(h, path, mode)?;
    Ok($File { cell: $os.cell_new(fd, 0, 0, 0), writing: mode != 0 })
}

/**
 * A real open file. Its cell, shared by every copy, holds the descriptor
 * (slot 0, -1 once closed), where the unread part of what `read_line` read
 * ahead starts (slot 1), the lines read so far (slot 2), and the read-ahead.
 */
struct $File {
    cell: $Resource,
    writing: bool,
}

impl File for $File {
    fun read(self, max: i64): Result<u8[], string> {
        let fd = self.reading()?;
        if max < 1 || max > 16777216 {
            return Err("max must be from 1 to 16777216");
        }
        let buf = $os.cell_bytes(self.cell);
        let pos = $os.cell_get(self.cell, 1);
        if pos >= buf.len {
            return $os.file_read(fd, max);
        }
        let end = if buf.len - pos > max { pos + max } else { buf.len };
        let got = $cut(buf, pos, end);
        if end == buf.len {
            $os.cell_set_bytes(self.cell, []);
            $os.cell_set(self.cell, 1, 0);
        } else {
            $os.cell_set(self.cell, 1, end);
        }
        Ok(got)
    }

    fun read_line(self): Result<Option<string>, string> {
        let fd = self.reading()?;
        let mut buf = $os.cell_bytes(self.cell);
        let mut pos = $os.cell_get(self.cell, 1);
        let mut i = pos;
        while true {
            while i < buf.len {
                if buf[i] == 10 {
                    let end = if i > pos && buf[i - 1] == 13 { i - 1 } else { i };
                    let bytes = $cut(buf, pos, end);
                    self.keep(buf, i + 1);
                    return self.text(bytes);
                }
                i += 1;
            }
            // Keep what was read ahead even when the next read fails.
            self.keep(buf, pos);
            let more = $os.file_read(fd, 65536)?;
            if more.len == 0 {
                if pos == buf.len {
                    return Ok(None);
                }
                let bytes = $cut(buf, pos, buf.len);
                self.keep([], 0);
                return self.text(bytes);
            }
            // Drop the lines already given once they are most of the buffer,
            // so it stays about one line plus one read long.
            if pos * 2 > buf.len {
                buf = $cut(buf, pos, buf.len);
                i -= pos;
                pos = 0;
            }
            for b of more {
                buf.push(b);
            }
        }
        panic("unreachable");
    }

    fun write(self, bytes: u8[]): Result<(), string> {
        let fd = $os.cell_get(self.cell, 0);
        if fd < 0 {
            return Err("closed");
        }
        if !self.writing {
            return Err("not open for writing");
        }
        $os.file_write(fd, bytes)?;
        Ok(())
    }

    fun close(self) {
        let fd = $os.cell_get(self.cell, 0);
        if fd >= 0 {
            $os.file_close(fd);
            $os.cell_set(self.cell, 0, -1);
            $os.cell_set_bytes(self.cell, []);
            $os.cell_set(self.cell, 1, 0);
        }
    }
}

impl $File {
    /** The descriptor, if this file is open for reading. */
    fun reading(self): Result<i64, string> {
        let fd = $os.cell_get(self.cell, 0);
        if fd < 0 {
            return Err("closed");
        }
        if self.writing {
            return Err("not open for reading");
        }
        Ok(fd)
    }

    /** Stores the read-ahead buffer and where the unread part starts. */
    fun keep(self, buf: u8[], pos: i64) {
        $os.cell_set_bytes(self.cell, buf);
        $os.cell_set(self.cell, 1, pos);
    }

    /** The next line's bytes as text, counting the line. */
    fun text(self, bytes: u8[]): Result<Option<string>, string> {
        let n = $os.cell_get(self.cell, 2) + 1;
        $os.cell_set(self.cell, 2, n);
        match string_from_utf8(bytes) {
            .Ok(line) => Ok(Some(line)),
            .Err(_) => Err("line {n} is not valid UTF-8"),
        }
    }
}

/** `bytes[from..to]` as a new array. */
fun $cut(bytes: u8[], from: i64, to: i64): u8[] {
    let mut out: u8[] = [];
    for i in from..to {
        out.push(bytes[i]);
    }
    out
}

/** The system clocks. */
struct $Clock {}

impl Clock for $Clock {
    fun now_ms(self): i64 = $os.wall_ms();
    fun monotonic_ms(self): i64 = $os.now_ms();
    fun local_offset(self, ms: i64): Result<i64, string> {
        // Seconds, rounded down for moments before 1970 too.
        let seconds = if ms >= 0 || ms % 1000 == 0 { ms / 1000 } else { ms / 1000 - 1 };
        $os.local_offset(seconds)
    }
}

/** The process's environment. */
struct $Env {}

impl Env for $Env {
    fun get(self, name: string): Option<string> = match $os.env(name) {
        .Some(bytes) => string_from_utf8(bytes).ok(),
        .None => None,
    };
}

/** The system's programs. */
struct $Proc {}

impl Proc for $Proc {
    fun run(self, cmd: string, args: string[]): Result<ProcessOutput, string> = $started(cmd, args, "", 1);
    fun run_with(self, cmd: string, args: string[], input: string): Result<ProcessOutput, string> =
        $started(cmd, args, input, 2);
    fun call(self, cmd: string, args: string[]): Result<i32, string> {
        let (code, _, _) = $os.start(cmd, args, "", 0)?;
        Ok(code)
    }
}

/** `$os.start` in `mode` 1 (capture, stdin empty) or 2 (capture, stdin `input`), with the output checked as UTF-8. */
fun $started(cmd: string, args: string[], input: string, mode: i32): Result<ProcessOutput, string> {
    let (code, out, err) = $os.start(cmd, args, input, mode)?;
    let stdout = match string_from_utf8(out) {
        .Ok(text) => text,
        .Err(_) => {
            return Err("stdout is not valid UTF-8");
        }
    };
    let stderr = match string_from_utf8(err) {
        .Ok(text) => text,
        .Err(_) => {
            return Err("stderr is not valid UTF-8");
        }
    };
    Ok(ProcessOutput { code: code, stdout: stdout, stderr: stderr })
}

/** The kernel's randomness (`getrandom`). */
struct $Entropy {}

impl Entropy for $Entropy {
    // Eight bytes per kernel read: fine for keys and seeds.
    fun bytes(self, n: i64): u8[] {
        if n < 0 {
            panic("entropy.bytes({n}): a negative count");
        }
        let mut out: u8[] = [];
        while out.len < n {
            let mut word = $os.seed();
            for _ in 0..8 {
                if out.len < n {
                    out.push((word & 255).truncate<u8>());
                    word = word >> 8;
                }
            }
        }
        out
    }
    fun next_u64(self): u64 = $os.seed();
}

/** The console `main` and tests are given. */
fun $console(): Console = $Console {};

/** The file system `main` and tests are given. */
fun $fs(): Fs = $Fs {};

/** The clock `main` and tests are given. */
fun $clock(): Clock = $Clock {};

/** The environment `main` and tests are given. */
fun $env(): Env = $Env {};

/** The programs `main` and tests may start. */
fun $proc(): Proc = $Proc {};

/** The randomness `main` and tests are given. */
fun $entropy(): Entropy = $Entropy {};
