// Scopes and their tasks: the handle `scope s { … }` names, and the values
// a scope's failure, a task's end and a cancellation are.

/**
 * A scope's handle: `scope s { … }` names one, and `s.spawn(work(x))`
 * starts a task in it. Every task a scope starts finishes before the scope
 * does. `main` and tests may take the root scope by asking for a `Scope`.
 * A handle may be passed as an argument, and nothing else: it can't be
 * returned, stored, sent or captured.
 */
struct Scope<E> { $rec: CPtr }

/** The root scope `main` and tests take: its tasks finish before the program does. */
fun $root_scope(): Scope<Error> = Scope { $rec: $os.scope_root() };

/** Why a task was cancelled. */
enum Reason {
    /** Another task in its scope failed, or the scope's body did. */
    SiblingFailed,
    /** Its scope's body was left early, by `return`, `?` or `break`. */
    Parent,
    /** `t.cancel(why)`. */
    Requested(string),
}

impl Display for Reason {
    fun show(self): string = match self {
        .SiblingFailed => "another task in its scope failed",
        .Parent => "its scope was left early",
        .Requested(why) => why,
    };
}

/**
 * How a task ended without its value: what `t.join()` gives instead.
 * A task returning `Err` failed with that error.
 */
enum Stopped {
    Cancelled(Reason),
    Failed(Error),
    Panicked(string),
}

impl Display for Stopped {
    fun show(self): string = match self {
        .Cancelled(why) => "cancelled: {why}",
        .Failed(e) => "failed: {e}",
        .Panicked(message) => "panicked: {message}",
    };
}

/** A stopped task is an error: `t.join()?` passes it on. */
impl Error for Stopped {}

/**
 * Why a scope failed: which task (`task`, its name: what `t.name(…)` set,
 * else the called function's) and how (`kind`). The first failure cancels
 * everything else an all-or-nothing scope runs. `E` is the scope's error
 * type: `Error` unless the scope says `scope<E>`.
 */
struct Failure<E> { task: string, kind: FailureKind<E> }

/** How a task failed: it returned this error, or it panicked with this message. */
enum FailureKind<E> {
    Error(E),
    Panic(string),
}

impl Display for Failure<E: Display> {
    fun show(self): string = match self.kind {
        .Error(e) => "task `{self.task}` failed: {e}",
        .Panic(message) => "task `{self.task}` panicked: {message}",
    };
}

/** A failed scope is an error: `scope s { … }?` passes it on. */
impl Error for Failure<E: Error> {}

/** What an `independent` scope does with a failure it has no handler for. */
fun $report_failure(f: Failure<Error>) {
    eprintln(f.show());
}
