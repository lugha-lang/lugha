// What a plain test is given in place of the real world: a fresh folder,
// a fixed clock, an empty environment, seeded randomness and the loopback
// network. Only a test executable's entry calls the makers at the end.

/** A clock stopped at 2000-01-01T00:00:00Z, in UTC. */
struct $TestClock {}

impl Clock for $TestClock {
    fun now_ms(self): i64 = 946684800000;
    fun monotonic_ms(self): i64 = 0;
    fun local_offset(self, ms: i64): Result<i64, string> = Ok(0);
}

/** An environment with no variables. */
struct $TestEnv {}

impl Env for $TestEnv {
    fun get(self, name: string): Option<string> = None;
}

/** splitmix64 from seed 0: the same numbers in every test and every run. */
struct $TestEntropy { state: Ref<u64> }

impl Entropy for $TestEntropy {
    fun bytes(self, n: i64): u8[] {
        if n < 0 {
            panic("entropy.bytes({n}): a negative count");
        }
        let mut out: u8[] = [];
        while out.len < n {
            let mut word = self.next_u64();
            for _ in 0..8 {
                if out.len < n {
                    out.push((word & 255).truncate<u8>());
                    word = word >> 8;
                }
            }
        }
        out
    }
    fun next_u64(self): u64 {
        let state = self.state.get().wrapping_add(11400714819323198485);
        self.state.set(state);
        let a = (state ^ (state >> 30)).wrapping_mul(13787848793156543929);
        let b = (a ^ (a >> 27)).wrapping_mul(10723151780598845931);
        b ^ (b >> 31)
    }
}

/** The real network, but only this machine: `127.0.0.1`, `::1` and `localhost`. */
struct $TestNet { real: Net }

impl Net for $TestNet {
    fun connect_timeout(self, addr: string, ms: i64): Result<Conn, string> {
        $loopback(addr)?;
        self.real.connect_timeout(addr, ms)
    }
    fun listen(self, addr: string): Result<Listener, string> {
        $loopback(addr)?;
        self.real.listen(addr)
    }
    fun resolve(self, name: string): Result<string[], string> {
        if !$loopback_host(name) {
            return Err("a test's network is this machine only: {name}");
        }
        self.real.resolve(name)
    }
    fun udp_bind(self, addr: string): Result<Udp, string> {
        $loopback(addr)?;
        self.real.udp_bind(addr)
    }
    fun udp_bind_shared(self, addr: string): Result<Udp, string> {
        $loopback(addr)?;
        self.real.udp_bind_shared(addr)
    }
    fun interfaces(self): Result<NetInterface[], string> = Ok([]);
}

/** `Ok` when `addr` (`host:port`, or an IPv6 address in brackets and a port) names this machine. */
fun $loopback(addr: string): Result<(), string> {
    let parts = addr.split(":");
    let host = if addr.starts_with("[") {
        let inside = addr.split("]")[0];
        inside.slice(1, inside.len)
    } else if parts.len == 2 {
        parts[0]
    } else {
        addr
    };
    if $loopback_host(host) {
        Ok(())
    } else {
        Err("a test's network is this machine only: {addr}")
    }
}

/** Whether `host` is one of the loopback names a test may use. */
fun $loopback_host(host: string): bool = host == "127.0.0.1" || host == "::1" || host == "localhost";

/**
 * The folder a test is given: `LUGHA_TEST_DIR` (or where it runs), a `Dir`
 * confined to it by the kernel like any other.
 */
fun $test_dir(): Dir {
    let base = match $os.env("LUGHA_TEST_DIR") {
        .Some(bytes) => string_from_utf8(bytes).unwrap_or("."),
        .None => ".",
    };
    match $fs().dir(base) {
        .Ok(d) => d,
        .Err(e) => panic("can't open the test's folder {base}: {e}"),
    }
}

/** The clock a plain test is given. */
fun $test_clock(): Clock = $TestClock {};

/** The environment a plain test is given. */
fun $test_env(): Env = $TestEnv {};

/** The randomness a plain test is given. */
fun $test_entropy(): Entropy = $TestEntropy { state: Ref.new(0) };

/** The network a plain test is given. */
fun $test_net(): Net = $TestNet { real: $net() };
