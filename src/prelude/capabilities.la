// Capabilities: what a program needs to touch the world outside it. `main`
// takes the ones it uses as parameters, and passes them on; each is an
// interface, so a fake for a test is a type that implements it. The real
// ones (in the next file) reach the runtime through the intrinsics and
// `$os` built-ins only the prelude and std may call.

/**
 * Standard input, output and error: `console.println("hello")`.
 * `main` takes one as a parameter, `fun main(console: Console)`.
 */
interface Console: Sendable {
    /** Writes `x`'s text to standard output, with no newline. */
    fun print(self, x: Display);
    /** Writes `x`'s text and a newline to standard output. */
    fun println(self, x: Display);
    /** Writes `x`'s text to standard error, after flushing standard output. */
    fun eprint(self, x: Display);
    /** Writes `x`'s text and a newline to standard error, after flushing standard output. */
    fun eprintln(self, x: Display);
    /**
     * The next line of standard input without its `\n` and a `\r` before it; `None` at the end.
     * A line that isn't UTF-8 is `Err("line N is not valid UTF-8")` and is skipped; a failed read
     * is `Err("stdin: …")`, never the end.
     */
    fun read_line(self): Result<Option<string>, string>;
    /** The rest of standard input as bytes, all of it: `[]` at the end; a failed read is `Err("stdin: …")`. */
    fun read_bytes(self): Result<u8[], string>;
    /** Writes out what standard output holds now: a prompt shows before a long wait. */
    fun flush(self);
    /** This console narrowed to standard output: `eprint` and `eprintln` do nothing, and there is no input. */
    fun stdout_only(self): Console = OneStream { under: self, stdout: true };
    /** This console narrowed to standard error: `print` and `println` do nothing, and there is no input. */
    fun stderr_only(self): Console = OneStream { under: self, stdout: false };
}

/**
 * Files and folders: `fs.cwd()` is the folder the program started in.
 * `main` takes one as a parameter, `fun main(fs: Fs)`.
 */
interface Fs: Sendable {
    /** The folder the program started in, as a `Dir`: that folder and below only. */
    fun cwd(self): Dir;
    /**
     * Any folder, by its path (absolute, or from the working folder), as a
     * `Dir`: that folder and below only. The one way to reach outside a `Dir`.
     */
    fun dir(self, path: string): Result<Dir, string>;
}

/**
 * A folder, through which files are read and written: paths are relative
 * to it, and never reach above it. An absolute path, a `..` above the
 * folder, or a symbolic link leading out is `Err("path leads outside the
 * folder")` (or `false`), checked by the kernel at each step of the path.
 * Errors are otherwise the system's message (`"No such file or
 * directory"`); a path holding a NUL byte is `Err("path contains a NUL
 * byte")`. Nothing here deletes recursively. A fake implements the methods
 * without a body; the others are written over them.
 */
interface Dir: Sendable {
    /** A folder inside this one, as a `Dir` reaching only it and below. */
    fun dir(self, path: string): Result<Dir, string>;
    /** This folder for reading only: a `ReadDir`, which has no method that changes anything. */
    fun read_only(self): ReadDir;
    /** The whole file as text, any bytes that aren't UTF-8 shown as U+FFFD. */
    fun read_file(self, path: string): Result<string, string>;
    /** The whole file as bytes. */
    fun read_bytes(self, path: string): Result<u8[], string>;
    /** Replaces the file's contents, making it if needed: `Ok` with the bytes written. */
    fun write_bytes(self, path: string, bytes: u8[]): Result<i64, string>;
    /** Adds to the end of the file, making it if needed: `Ok` with the bytes written. */
    fun append_bytes(self, path: string, bytes: u8[]): Result<i64, string>;
    /** The names in a folder, sorted by their bytes, without `.` and `..`; `Err` also when a name isn't UTF-8. */
    fun list(self, path: string): Result<string[], string>;
    /** Makes one folder (mode 0777 less the umask); its parent must exist. */
    fun make_dir(self, path: string): Result<(), string>;
    /** Removes a file or a symbolic link; never a folder. */
    fun remove_file(self, path: string): Result<(), string>;
    /** Removes a folder, which must be empty. */
    fun remove_dir(self, path: string): Result<(), string>;
    /** Whether something exists at `path`, following symbolic links. */
    fun exists(self, path: string): bool;
    /** Whether `path` is a folder. */
    fun is_dir(self, path: string): bool;
    /** Whether `path` is a regular file. */
    fun is_file(self, path: string): bool;
    /**
     * The size in bytes of the regular file at `path`, following symbolic
     * links, without opening it: `Err("Is a directory")` for a folder,
     * `Err("not a regular file")` for anything else but a file.
     */
    fun size(self, path: string): Result<i64, string>;
    /**
     * Renames `from` to `to`, replacing `to` in one step: anyone opening `to`
     * sees the old file or the new one, never neither. Only within one file
     * system (`Invalid cross-device link` otherwise), never a copy.
     */
    fun rename(self, from: string, to: string): Result<(), string>;
    /** Sets the permission bits (`chmod`), following symbolic links: `mode` from 0 to 0o7777. */
    fun set_mode(self, path: string, mode: i64): Result<(), string>;
    /** Writes a file's data, or a folder's entries, out to the disk (`fsync`), so it survives a power cut. */
    fun sync(self, path: string): Result<(), string>;
    /** Opens a file for reading. */
    fun open(self, path: string): Result<File, string>;
    /** Opens a file for writing, emptying it first, or makes it (mode 0666 less the umask). */
    fun create(self, path: string): Result<File, string>;
    /** Opens a file for writing at its end, making it if needed: every write lands at the end. */
    fun append(self, path: string): Result<File, string>;
    /** The folder's absolute path, or `Err` with the system's message. */
    fun path(self): Result<string, string>;

    /** Replaces the file's contents with `text`, making it if needed: `Ok` with the bytes written. */
    fun write_file(self, path: string, text: string): Result<i64, string> = self.write_bytes(path, text.to_bytes());
    /** Adds `text` to the end of the file, making it if needed: `Ok` with the bytes written. */
    fun append_file(self, path: string, text: string): Result<i64, string> = self.append_bytes(path, text.to_bytes());
    /** Makes a folder and any missing parents; fine if it exists already. */
    fun make_dirs(self, path: string): Result<(), string> {
        let mut prefix = if path.starts_with("/") { "/" } else { "" };
        for part of path.split("/") {
            if part.len == 0 {
                continue;
            }
            prefix = if prefix.len == 0 || prefix.ends_with("/") { prefix + part } else { prefix + "/" + part };
            if !self.is_dir(prefix) {
                self.make_dir(prefix)?;
            }
        }
        Ok(())
    }
}

/**
 * A folder that can only be read: `dir.read_only()` gives one. It is
 * confined as a `Dir` is, and has no method that changes anything, so code
 * given one can't write, by its type. A fake implements these ten methods.
 */
interface ReadDir: Sendable {
    /** A folder inside this one, as a `ReadDir` reaching only it and below. */
    fun dir(self, path: string): Result<ReadDir, string>;
    /** The whole file as text, any bytes that aren't UTF-8 shown as U+FFFD. */
    fun read_file(self, path: string): Result<string, string>;
    /** The whole file as bytes. */
    fun read_bytes(self, path: string): Result<u8[], string>;
    /** The names in a folder, sorted by their bytes, without `.` and `..`; `Err` also when a name isn't UTF-8. */
    fun list(self, path: string): Result<string[], string>;
    /** Whether something exists at `path`, following symbolic links. */
    fun exists(self, path: string): bool;
    /** Whether `path` is a folder. */
    fun is_dir(self, path: string): bool;
    /** Whether `path` is a regular file. */
    fun is_file(self, path: string): bool;
    /** The size in bytes of the regular file at `path`, as `Dir`'s `size`. */
    fun size(self, path: string): Result<i64, string>;
    /** Opens a file for reading. */
    fun open(self, path: string): Result<File, string>;
    /** The folder's absolute path, or `Err` with the system's message. */
    fun path(self): Result<string, string>;
}

/**
 * An open file, from a `Dir`'s `open` (reading), `create` or `append`
 * (writing), never both. Every copy is the same stream. Close what you open:
 * a file is never closed for you. Reads and writes run on a helper thread
 * while the task waits, so a FIFO or a terminal that waits stalls only
 * its own task. A writing file used to read
 * is `Err("not open for reading")`, the reverse `Err("not open for
 * writing")`, and any use after `close` is `Err("closed")`.
 */
interface File: Sendable {
    /** Up to `max` bytes (1 to 16777216): what `read_line` read ahead first, else one read; `[]` at the end. */
    fun read(self, max: i64): Result<u8[], string>;
    /**
     * The next line, without its `\n` and one `\r` before it: `None` at the
     * end; a line that isn't UTF-8 is `Err("line N is not valid UTF-8")` and
     * is skipped.
     */
    fun read_line(self): Result<Option<string>, string>;
    /** Writes every byte, straight to the file: nothing waits in a buffer. */
    fun write(self, bytes: u8[]): Result<(), string>;
    /** Closes the file and every copy of it; closing twice is fine. */
    fun close(self);

    /** Writes a string's bytes, as `write` does. */
    fun write_text(self, s: string): Result<(), string> = self.write(s.to_bytes());
}

/**
 * The real date and time: `clock.now_ms()`. Pausing (`std.task.sleep`)
 * needs no clock.
 */
interface Clock: Sendable {
    /**
     * Milliseconds since 1970-01-01 00:00 UTC, from the system clock. It can
     * jump when the clock is set: measure intervals with `monotonic_ms`.
     */
    fun now_ms(self): i64;
    /** Milliseconds from an unspecified start that never goes back: subtract two readings to measure an interval. */
    fun monotonic_ms(self): i64;
    /**
     * The system time zone's offset from UTC at moment `ms`, in seconds east
     * (`TZ` if set, else `/etc/localtime`; UTC when neither says), daylight
     * saving included: ask again for each moment.
     */
    fun local_offset(self, ms: i64): Result<i64, string>;
}

/** The environment variables, read-only: `env.get("HOME")`. */
interface Env: Sendable {
    /** The variable `name`: `None` when it is unset, isn't valid UTF-8, or `name` contains a NUL byte. */
    fun get(self, name: string): Option<string>;
    /** This environment narrowed to the variables `names`: any other reads as unset. */
    fun only(self, names: string[]): Env = OnlyEnv { under: self, names: names };
}

/**
 * Starting other programs and waiting for them. There is never a shell:
 * `cmd` and each argument reach the program exactly as given, so `;`, `|`,
 * `$( )` and globs mean nothing. A `cmd` without `/` is looked up on `PATH`,
 * one with `/` is a path. The program gets this one's environment and
 * working folder, and only stdin, stdout and stderr: every other descriptor
 * is closed on exec.
 */
interface Proc: Sendable {
    /** Runs a program with its stdin empty, capturing its output: any exit code is `Ok`; `Err` when it couldn't start or its output isn't UTF-8. */
    fun run(self, cmd: string, args: string[]): Result<ProcessOutput, string>;
    /** `run`, with `input` written to the program's stdin. */
    fun run_with(self, cmd: string, args: string[], input: string): Result<ProcessOutput, string>;
    /** Runs a program sharing this one's stdin, stdout and stderr: its exit code, or `Err` when it couldn't start. */
    fun call(self, cmd: string, args: string[]): Result<i32, string>;
}

/** What a finished program left: its exit code (`128 + n` when signal `n` ended it), and everything it wrote to stdout and stderr. */
public struct ProcessOutput { public code: i32, public stdout: string, public stderr: string } with Eq

/**
 * The operating system's randomness, for keys, nonces and seeds. A seeded
 * generator (`std.random`) needs none.
 */
interface Entropy: Sendable {
    /** `n` random bytes; panics when `n` is negative. */
    fun bytes(self, n: i64): u8[];
    /** 64 random bits. */
    fun next_u64(self): u64;
}

