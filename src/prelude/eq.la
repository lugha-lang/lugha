// Equality and hashing: `Eq` gives `==`, and `Key`, which extends it,
// lets a value be a map's key or a set's value, hashing it into a
// `Hasher`: SipHash-1-3, keyed by a secret the runtime draws for each
// process, over the same structure `eq` compares, so equal values hash
// equal and nobody can choose keys that collide. Both are derivable, with
// a block per kind of type: a struct or enum asks with `with Eq` or
// `with Key`.

/** Values that can be compared with `==`. */
public interface Eq {
    /** True if `self` and `other` are equal: what `==` does. */
    fun eq(self, other: Self): bool;
}

/**
 * Values that can be map keys and set values: equal values hash equal,
 * and every value equals itself (`assert_key_laws` checks both).
 */
public interface Key: Eq {
    /** `self` fed into `h`, part by part, as `eq` compares them. */
    fun hash(self, mut h: Hasher);
}

/**
 * The running state of a hash: feed values with `add`, read it with
 * `finish`. Keyed by a secret drawn for each run, so a hash differs
 * between runs: never store or send one.
 */
public struct Hasher {
    private v0: u64,
    private v1: u64,
    private v2: u64,
    private v3: u64,
    private len: u64,
}

impl Hasher {
    /** An empty hash, under this process's key. */
    fun new(): Hasher {
        let (k0, k1) = ($hash.key(0), $hash.key(1));
        Hasher {
            v0: k0 ^ 0x736f6d6570736575,
            v1: k1 ^ 0x646f72616e646f6d,
            v2: k0 ^ 0x6c7967656e657261,
            v3: k1 ^ 0x7465646279746573,
            len: 0,
        }
    }

    /** `x` fed in. */
    fun add<T: Key>(mut self, x: T) {
        x.hash(mut self);
    }

    /** The hash of everything fed in so far. */
    fun finish(self): u64 {
        let mut h = self;
        let b = (h.len & 0xff) * 0x0100000000000000;
        h.v3 = h.v3 ^ b;
        h.$round();
        h.v0 = h.v0 ^ b;
        h.v2 = h.v2 ^ 0xff;
        h.$round();
        h.$round();
        h.$round();
        h.v0 ^ h.v1 ^ h.v2 ^ h.v3
    }

    /** One SipHash block, eight bytes: one round (the 1 of 1-3). */
    fun $word(mut self, m: u64) {
        self.v3 = self.v3 ^ m;
        self.$round();
        self.v0 = self.v0 ^ m;
        self.len = self.len.wrapping_add(8);
    }

    /** SipRound. */
    fun $round(mut self) {
        self.v0 = self.v0.wrapping_add(self.v1);
        self.v1 = self.v1.rotate_left(13) ^ self.v0;
        self.v0 = self.v0.rotate_left(32);
        self.v2 = self.v2.wrapping_add(self.v3);
        self.v3 = self.v3.rotate_left(16) ^ self.v2;
        self.v0 = self.v0.wrapping_add(self.v3);
        self.v3 = self.v3.rotate_left(21) ^ self.v0;
        self.v2 = self.v2.wrapping_add(self.v1);
        self.v1 = self.v1.rotate_left(17) ^ self.v2;
        self.v2 = self.v2.rotate_left(32);
    }

    /** A string's bytes fed in, eight at a time, then its length. */
    fun $text(mut self, s: string) {
        let mut i = 0;
        while i < s.len {
            self.$word($hash.chunk(s, i));
            i += 8;
        }
        self.$word(s.len.truncate<u64>());
    }
}

/**
 * Panics unless `a` equals itself and, when `a == b`, both hash the same:
 * what a map needs of its keys.
 */
fun assert_key_laws<T: Key>(a: T, b: T) {
    if a != a {
        panic("assert_key_laws: a value isn't equal to itself");
    }
    if b != b {
        panic("assert_key_laws: a value isn't equal to itself");
    }
    if a == b {
        let mut ha = Hasher.new();
        a.hash(mut ha);
        let mut hb = Hasher.new();
        b.hash(mut hb);
        if ha.finish() != hb.finish() {
            panic("assert_key_laws: equal values hash differently");
        }
    }
}

/** A field or payload, fed in. */
fun $part<F: Key>(h: Hasher, name: string, x: F): Hasher {
    let mut g = h;
    x.hash(mut g);
    g
}

/** A pair of fields or payloads, compared. */
fun $same<F: Eq>(name: string, x: F, y: F): bool = x.eq(y);

derive Eq for i8 {
    fun eq(self, other: i8): bool = self == other;
}

derive Key for i8 {
    fun hash(self, mut h: Hasher) {
        h.$word(self.truncate<u64>());
    }
}

derive Eq for i16 {
    fun eq(self, other: i16): bool = self == other;
}

derive Key for i16 {
    fun hash(self, mut h: Hasher) {
        h.$word(self.truncate<u64>());
    }
}

derive Eq for i32 {
    fun eq(self, other: i32): bool = self == other;
}

derive Key for i32 {
    fun hash(self, mut h: Hasher) {
        h.$word(self.truncate<u64>());
    }
}

derive Eq for i64 {
    fun eq(self, other: i64): bool = self == other;
}

derive Key for i64 {
    fun hash(self, mut h: Hasher) {
        h.$word(self.truncate<u64>());
    }
}

derive Eq for u8 {
    fun eq(self, other: u8): bool = self == other;
}

derive Key for u8 {
    fun hash(self, mut h: Hasher) {
        h.$word(self as u64);
    }
}

derive Eq for u16 {
    fun eq(self, other: u16): bool = self == other;
}

derive Key for u16 {
    fun hash(self, mut h: Hasher) {
        h.$word(self as u64);
    }
}

derive Eq for u32 {
    fun eq(self, other: u32): bool = self == other;
}

derive Key for u32 {
    fun hash(self, mut h: Hasher) {
        h.$word(self as u64);
    }
}

derive Eq for u64 {
    fun eq(self, other: u64): bool = self == other;
}

derive Key for u64 {
    fun hash(self, mut h: Hasher) {
        h.$word(self);
    }
}

/** Floats compare by IEEE rules, `NaN != NaN`, so they are never keys. */
derive Eq for f32 {
    fun eq(self, other: f32): bool = self == other;
}

derive Eq for f64 {
    fun eq(self, other: f64): bool = self == other;
}

derive Eq for bool {
    fun eq(self, other: bool): bool = self == other;
}

derive Key for bool {
    fun hash(self, mut h: Hasher) {
        h.$word(if self { 1 } else { 0 });
    }
}

derive Eq for char {
    fun eq(self, other: char): bool = self == other;
}

derive Key for char {
    fun hash(self, mut h: Hasher) {
        h.$word(self as u64);
    }
}

derive Eq for string {
    fun eq(self, other: string): bool = self == other;
}

derive Key for string {
    fun hash(self, mut h: Hasher) {
        h.$text(self);
    }
}

derive Eq for () {
    fun eq(self, other: ()): bool = true;
}

derive Key for () {
    fun hash(self, mut h: Hasher) {}
}

/** The length, then each element. */
derive<T: Eq> Eq for T[] {
    fun eq(self, other: T[]): bool {
        if self.len != other.len {
            return false;
        }
        // `==` reads both; a method call on an element would make the loop
        // copy a shared `self` first, as if it could change it.
        for i in 0..self.len {
            if self[i] != other[i] {
                return false;
            }
        }
        true
    }
}

derive<T: Key> Key for T[] {
    fun hash(self, mut h: Hasher) {
        h.$word(self.len.truncate<u64>());
        for x of self {
            x.hash(mut h);
        }
    }
}

/** Each field, in declaration order. */
derive Eq for struct {
    fun eq(self, other: Self): bool = derive.all(self, other, $same);
}

derive Key for struct {
    fun hash(self, mut h: Hasher) {
        h = derive.fold(self, h, $part);
    }
}

derive Eq for tuple {
    fun eq(self, other: Self): bool = derive.all(self, other, $same);
}

derive Key for tuple {
    fun hash(self, mut h: Hasher) {
        h = derive.fold(self, h, $part);
    }
}

/** The same variant with equal payloads; hashed by the variant's position, then its payloads. */
derive Eq for enum {
    fun eq(self, other: Self): bool = derive.all(self, other, $same);
}

derive Key for enum {
    fun hash(self, mut h: Hasher) {
        h.$word(derive.index(self).truncate<u64>());
        h = derive.fold(self, h, $part);
    }
}

/** The same C object: one address. */
derive Eq for handle {
    fun eq(self, other: Self): bool = derive.address(self) == derive.address(other);
}

derive Key for handle {
    fun hash(self, mut h: Hasher) {
        h.$word(derive.address(self));
    }
}

/** Equal keys with equal values, in any order. */
derive<K: Key, V: Eq> Eq for Map<K, V> {
    fun eq(self, other: Map<K, V>): bool = self.same(other);
}

/** Entries hash by wrapping sum, so their order doesn't matter. */
derive<K: Key, V: Key> Key for Map<K, V> {
    fun hash(self, mut h: Hasher) {
        let mut sum: u64 = 0;
        for (k, x) of self {
            let mut e = Hasher.new();
            k.hash(mut e);
            x.hash(mut e);
            sum = sum.wrapping_add(e.finish());
        }
        h.$word(self.len.truncate<u64>());
        h.$word(sum);
    }
}

/** The same elements, in any order. */
derive<T: Key> Eq for Set<T> {
    fun eq(self, other: Set<T>): bool = self.same(other);
}

derive<T: Key> Key for Set<T> {
    fun hash(self, mut h: Hasher) {
        let mut sum: u64 = 0;
        for x of self {
            let mut e = Hasher.new();
            x.hash(mut e);
            sum = sum.wrapping_add(e.finish());
        }
        h.$word(self.len.truncate<u64>());
        h.$word(sum);
    }
}
