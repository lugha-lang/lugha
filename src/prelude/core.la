// The Lugha prelude: the methods of arrays, strings, `Option` and
// `Result` (`xs.map(f)`, `s.trim()`, `o.unwrap_or(d)`), as blocks of each
// type's own methods. It is checked with every program and each method is
// compiled only for the types a program uses. Programs can't name this
// module or add such blocks; a method call is the way in.
//
// Every method takes its receiver as a plain `self`, so the caller's value
// never changes, and every array it returns is new.

// Success or failure: `Ok` and `Err` are written without
// `Result.` in programs, and `?` returns an `Err` early.
enum Result<T, E> { Ok(T), Err(E) }

/**
 * A new array of `a`'s elements, then `b`'s: `a + b`.
 */
fun $concat<T>(a: T[], b: T[]): T[] {
    let mut out = a;
    for x of b {
        out.push(x);
    }
    out
}

// ---- Strings ----
// Strings are bytes: these helpers compare and cut bytes, and `slice` (built
// into the compiler) makes each new string. ASCII codes: `\n` 10, `\r` 13,
// `\t` 9, space 32.

/** Used by `lines`: the text of `s` from `from` to `to`, without a trailing `\r`. */
fun str_line(s: string, from: i64, to: i64): string {
    if to > from && s[to - 1] == 13 {
        return s.slice(from, to - 1);
    }
    s.slice(from, to)
}

/** Used by `starts_with` and the others: whether `p` occurs in `s` at byte `at`. */
fun str_at(s: string, at: i64, p: string): bool {
    if at + p.len > s.len {
        return false;
    }
    for k in 0..p.len {
        if s[at + k] != p[k] {
            return false;
        }
    }
    true
}

/** Used by `trim`: whether `b` is a space, tab, `\n` or `\r`. */
fun str_is_space(b: u8): bool = b == 32 || b == 9 || b == 10 || b == 13;

// Anything that can be stepped through: `for x of e` loops over an `e`
// whose type implements it, `impl Iter<T> for X { fun next(mut self) … }`;
// a method merely named `next` doesn't count.
interface Iter<T> { fun next(mut self): Option<T>; }

impl<T> T[] {
    /**
     * A new array of `f` applied to each element, in order: `xs.map(f)`.
     * @param f the function for each element
     */
    fun map<U>(self, f: fun(T): U): U[] {
        let xs = self;
        let mut out: U[] = [];
        for x of xs {
            out.push(f(x));
        }
        out
    }

    /**
     * A new array of the elements `keep` accepts, in order: `xs.filter(keep)`.
     * @param keep true for an element to keep
     */
    fun filter(self, keep: fun(T): bool): T[] {
        let xs = self;
        let mut out: T[] = [];
        for x of xs {
            if keep(x) {
                out.push(x);
            }
        }
        out
    }

    /**
     * Combines the elements left to right, starting from `init`: `xs.fold(0, add)`.
     * @param init the starting value
     * @param f the running value and an element, giving the next value
     */
    fun fold<A>(self, init: A, f: fun(A, T): A): A {
        let xs = self;
        let mut acc = init;
        for x of xs {
            acc = f(acc, x);
        }
        acc
    }

    /** Whether `f` holds for some element (false for an empty array): `xs.any(f)`. */
    fun any(self, f: fun(T): bool): bool {
        let xs = self;
        for x of xs {
            if f(x) {
                return true;
            }
        }
        false
    }

    /** Whether `f` holds for every element (true for an empty array): `xs.all(f)`. */
    fun all(self, f: fun(T): bool): bool {
        let xs = self;
        for x of xs {
            if !f(x) {
                return false;
            }
        }
        true
    }

    // A stable bottom-up merge sort into a new array: runs of `width` are
    // merged pairwise from `src` into `dst`, then the buffers trade places. On a
    // tie the left run's element goes first, which keeps equal elements in
    // their original order. An inconsistent `less` still gives back every
    // element exactly once, in some order.
    /**
     * A sorted copy, stable, ordered by `less`: `xs.sort_by(less)`.
     * @param less whether its first argument goes before its second
     */
    fun sort_by(self, less: fun(T, T): bool): T[] {
        let xs = self;
        let n = xs.len;
        let mut src = xs;
        if n < 2 {
            return src;
        }
        let mut dst = xs;
        let mut width = 1;
        while width < n {
            let mut lo = 0;
            while lo < n {
                let mid = if lo + width < n { lo + width } else { n };
                let hi = if mid + width < n { mid + width } else { n };
                let mut a = lo;
                let mut b = mid;
                let mut k = lo;
                while k < hi {
                    if a < mid && (b >= hi || !less(src[b], src[a])) {
                        dst[k] = src[a];
                        a += 1;
                    } else {
                        dst[k] = src[b];
                        b += 1;
                    }
                    k += 1;
                }
                lo = hi;
            }
            swap(src, dst);
            width *= 2;
        }
        src
    }
}

impl string {
    // The lines of `s`: split at `\n`, one trailing `\r` dropped from each, and
    // no empty last line after a final `\n`.
    /** The lines of `s`, without their `\n` (or `\r\n`): `s.lines()`. */
    fun lines(self): string[] {
        let s = self;
        let mut out: string[] = [];
        let mut start = 0;
        for i in 0..s.len {
            if s[i] == 10 {
                out.push(str_line(s, start, i));
                start = i + 1;
            }
        }
        if start < s.len {
            out.push(str_line(s, start, s.len));
        }
        out
    }

    // The parts of `s` between occurrences of `sep`, empty parts kept.
    /**
     * The parts of `s` between each `sep`: `s.split(",")`.
     * @param sep the separator; an empty one splits nothing
     */
    fun split(self, sep: string): string[] {
        let s = self;
        if sep.len == 0 {
            panic("split with an empty separator");
        }
        let mut out: string[] = [];
        let mut start = 0;
        let mut i = 0;
        while i + sep.len <= s.len {
            if str_at(s, i, sep) {
                out.push(s.slice(start, i));
                i += sep.len;
                start = i;
            } else {
                i += 1;
            }
        }
        out.push(s.slice(start, s.len));
        out
    }

    /** `s` without spaces, tabs and line breaks at both ends: `s.trim()`. */
    fun trim(self): string {
        let s = self;
        let mut from = 0;
        let mut to = s.len;
        while from < to && str_is_space(s[from]) {
            from += 1;
        }
        while to > from && str_is_space(s[to - 1]) {
            to -= 1;
        }
        s.slice(from, to)
    }

    /** Whether `sub` occurs in `s`: `s.contains(sub)`. */
    fun contains(self, sub: string): bool {
        let s = self;
        for i in 0..s.len - sub.len + 1 {
            if str_at(s, i, sub) {
                return true;
            }
        }
        false
    }

    /** Whether `s` begins with `p`: `s.starts_with(p)`. */
    fun starts_with(self, p: string): bool {
        let s = self;
        str_at(s, 0, p)
    }

    /** Whether `s` ends with `p`: `s.ends_with(p)`. */
    fun ends_with(self, p: string): bool {
        let s = self;
        p.len <= s.len && str_at(s, s.len - p.len, p)
    }
}

impl string[] {
    /** The strings of `xs` with `sep` between each two: `xs.join(", ")`. */
    fun join(self, sep: string): string {
        let xs = self;
        let mut out: u8[] = [];
        for i in 0..xs.len {
            let piece = if i > 0 { sep + xs[i] } else { xs[i] };
            for b of piece.to_bytes() {
                out.push(b);
            }
        }
        $string.from_bytes(out)
    }
}

impl<T> Option<T> {
    /** The `Some` value; panics with `unwrap on None` at the call otherwise: `o.unwrap()`. */
    @caller_location
    fun unwrap(self): T = match self {
        .Some(x) => x,
        .None => panic("unwrap on None"),
    };

    /** The `Some` value; panics with `message` at the call otherwise: `o.expect("why")`. */
    @caller_location
    fun expect(self, message: string): T = match self {
        .Some(x) => x,
        .None => panic(message),
    };

    /** The value inside, or `default` for `None`: `o.unwrap_or(default)`. */
    fun unwrap_or(self, default: T): T {
        let o = self;
        match o {
        .Some(x) => x,
        .None => default,
    }
    }

    /** `Ok` with the value inside, or `Err(error)` for `None`: `o.ok_or(error)`. */
    fun ok_or<E>(self, error: E): Result<T, E> {
        let o = self;
        match o {
        .Some(x) => Ok(x),
        .None => Err(error),
    }
    }

    /** `Some` with `f` applied to the value inside; `None` stays `None`: `o.map(f)`. */
    fun map<U>(self, f: fun(T): U): Option<U> {
        let o = self;
        match o {
        .Some(x) => Some(f(x)),
        .None => None,
    }
    }

    /** Whether there is a value: `o.is_some()`. */
    fun is_some(self): bool {
        let o = self;
        match o {
        .Some(_) => true,
        .None => false,
    }
    }

    /** Whether there is no value: `o.is_none()`. */
    fun is_none(self): bool {
        let o = self;
        !o.is_some()
    }
}

impl<T, E> Result<T, E> {
    /** The `Ok` value; panics at the call with `unwrap on Err: ` and the error's debug form otherwise: `r.unwrap()`. */
    @caller_location
    fun unwrap(self): T = match self {
        .Ok(x) => x,
        .Err(e) => panic("unwrap on Err: {e.debug()}"),
    };

    /** The `Ok` value; panics with `message` at the call otherwise: `r.expect("why")`. */
    @caller_location
    fun expect(self, message: string): T = match self {
        .Ok(x) => x,
        .Err(_) => panic(message),
    };

    /** The `Ok` value, or `default` for an `Err`: `r.unwrap_or(default)`. */
    fun unwrap_or(self, default: T): T {
        let r = self;
        match r {
        .Ok(x) => x,
        .Err(_) => default,
    }
    }

    /** `Some` with the `Ok` value, or `None` for an `Err`: `r.ok()`. */
    fun ok(self): Option<T> {
        let r = self;
        match r {
        .Ok(x) => Some(x),
        .Err(_) => None,
    }
    }

    /** `Ok` with `f` applied to the value; an `Err` stays as it is: `r.map(f)`. */
    fun map<U>(self, f: fun(T): U): Result<U, E> {
        let r = self;
        match r {
        .Ok(x) => Ok(f(x)),
        .Err(e) => Err(e),
    }
    }

    /** `Err` with `f` applied to the error; an `Ok` stays as it is: `r.map_err(f)`. */
    fun map_err<F>(self, f: fun(E): F): Result<T, F> {
        let r = self;
        match r {
        .Ok(x) => Ok(x),
        .Err(e) => Err(f(e)),
    }
    }

    /** Whether it is `Ok`: `r.is_ok()`. */
    fun is_ok(self): bool {
        let r = self;
        match r {
        .Ok(_) => true,
        .Err(_) => false,
    }
    }

    /** Whether it is `Err`: `r.is_err()`. */
    fun is_err(self): bool {
        let r = self;
        !r.is_ok()
    }
}

// Assertions, for tests and anywhere else: each panics at its call.

/** Panics with `assertion failed` unless `cond` holds. */
@caller_location
fun assert(cond: bool) {
    if !cond {
        panic("assertion failed");
    }
}

/** Panics unless `a == b`, showing both in their debug forms. */
@caller_location
fun assert_eq<T: Eq>(a: T, b: T) {
    if a != b {
        panic("assert_eq failed: left {a.debug()}, right {b.debug()}");
    }
}

/** Panics if `a == b`, showing the value in its debug form. */
@caller_location
fun assert_ne<T: Eq>(a: T, b: T) {
    if a == b {
        panic("assert_ne failed: both {a.debug()}");
    }
}
