// Maps and sets: `Map { k: v, … }` and `Set { x, … }`.
// A compact table: entries in insertion order (removed ones marked and
// compacted when half are), and `$slots`, open addressing with linear probing
// at a load of at most 2/3 over indexes into the entries. Values, like arrays:
// copies are independent. Keys are hashed by `Key`'s `hash`, which matches `==`.

/**
 * A map from keys to values, visited in insertion order: `Map { "ann": 31 }`.
 * Read with `m[k]` (panics when missing) or `m.get(k)`; write with `m[k] = v`.
 */
struct Map<K, V> {
    /** The number of entries. */
    len: i64,
    $keys: K[],
    $vals: V[],
    $live: bool[],
    $slots: i64[],
    $at: i64,
}

/**
 * A set of distinct values, visited in insertion order: `Set { 1, 2, 3 }`.
 */
struct Set<T> {
    /** The number of values. */
    len: i64,
    $map: Map<T, bool>,
}

/**
 * A type built from `key: value` entries with braces: `Map { "ann": 31 }`.
 * The literal calls `from_entries` with the keys and the values in order.
 */
interface FromEntries<K, V> {
    /** The value holding `keys[i]` with `values[i]`, in order. */
    fun from_entries(keys: K[], values: V[]): Self;
}

/**
 * A type built from items with braces: `Set { 1, 2, 3 }`. The literal
 * calls `from_items` with the items in order.
 */
interface FromItems<T> {
    /** The value holding `items`, in order. */
    fun from_items(items: T[]): Self;
}

/** `Map { "ann": 31, "bo": 40 }`; a later equal key replaces the value. */
impl<K: Key, V> FromEntries<K, V> for Map<K, V> {
    fun from_entries(keys: K[], values: V[]): Map<K, V> = $map_of(keys, values);
}

/** `Set { 1, 2, 3 }`; an item already in it is kept once. */
impl<T: Key> FromItems<T> for Set<T> {
    fun from_items(items: T[]): Set<T> = $set_of(items);
}

/** The slot `k` is in (`.0`) and its entry, or -1 when it has none (`.1`). */
fun $map_find<K: Key, V>(m: Map<K, V>, k: K): (i64, i64) {
    let mask = m.$slots.len - 1;
    let mut h = Hasher.new();
    k.hash(mut h);
    let mut i = (h.finish() & (mask.truncate<u64>())).truncate<i64>();
    while true {
        let s = m.$slots[i];
        if s == 0 {
            return (i, -1);
        }
        let e = s - 1;
        if m.$live[e] && m.$keys[e] == k {
            return (i, e);
        }
        i = (i + 1) & mask;
    }
    panic("unreachable")
}

/** A map of `keys[i]` to `vals[i]`; a later key replaces an earlier one's value. */
fun $map_of<K: Key, V>(keys: K[], vals: V[]): Map<K, V> {
    let mut m: Map<K, V> = Map { len: 0, $keys: [], $vals: [], $live: [], $slots: [0; 8], $at: 0 };
    for i in 0..keys.len {
        m.$put(keys[i], vals[i]);
    }
    m
}

/** A set of `xs`, each once, in their first order. */
fun $set_of<T: Key>(xs: T[]): Set<T> {
    let mut s: Set<T> = Set { len: 0, $map: $map_of([], []) };
    for x of xs {
        s.insert(x);
    }
    s
}

impl<K: Key, V> Map<K, V> {
    /**
     * Sets `k` to `v` in place: replaced, or added at the end, after growing
     * the table when it is full. Everything here changes `self` where it is,
     * through `mut self`: no copy, whoever else holds the map.
     */
    fun $put(mut self, k: K, v: V) {
        if (self.$keys.len + 1) * 3 > self.$slots.len * 2 {
            let mut cap = self.$slots.len;
            while (self.len + 1) * 3 > cap {
                cap = cap * 2;
            }
            self.$rebuild(cap);
        }
        let (slot, e) = $map_find(self, k);
        if e >= 0 {
            self.$vals[e] = v;
        } else {
            self.$keys.push(k);
            self.$vals.push(v);
            self.$live.push(true);
            self.$slots[slot] = self.$keys.len;
            self.len += 1;
        }
    }

    /** Keeps only the live entries, in order, over `cap` slots (a power of two). */
    fun $rebuild(mut self, cap: i64) {
        let mut keys: K[] = [];
        let mut vals: V[] = [];
        for e in 0..self.$keys.len {
            if self.$live[e] {
                keys.push(self.$keys[e]);
                vals.push(self.$vals[e]);
            }
        }
        self.$slots = [0; cap];
        self.$live = [true; keys.len];
        self.$keys = keys;
        self.$vals = vals;
        for e in 0..self.$keys.len {
            let (slot, _) = $map_find(self, self.$keys[e]);
            self.$slots[slot] = e + 1;
        }
    }

    /** The value of `k`, or `None`. */
    fun get(self, k: K): Option<V> {
        let (_, e) = $map_find(self, k);
        if e < 0 { None } else { Some(self.$vals[e]) }
    }

    /** True if `k` has a value. */
    fun has(self, k: K): bool = $map_find(self, k).1 >= 0;

    /** The value of `k` for `m[k]`, or the panic's message, which codegen raises at the `[`. */
    fun $entry(self, k: K): Result<V, string> {
        let (_, e) = $map_find(self, k);
        if e < 0 {
            return Err("no key {k.debug()} in the map");
        }
        Ok(self.$vals[e])
    }

    /** Where `k`'s value is in `$vals`, for a write inside `m[k]`, or the panic's message, which codegen raises at the `[`. */
    fun $slot(self, k: K): Result<i64, string> {
        let (_, e) = $map_find(self, k);
        if e < 0 {
            return Err("no key {k.debug()} in the map");
        }
        Ok(e)
    }

    /** Sets `k` to `v`: `m[k] = v`. A new key goes last; an old one keeps its place. */
    fun insert(mut self, k: K, v: V) {
        self.$put(k, v);
    }

    /** Removes `k`, giving its value, or `None` if it had none. */
    fun remove(mut self, k: K): Option<V> {
        let (_, e) = $map_find(self, k);
        if e < 0 {
            return None;
        }
        self.$live[e] = false;
        self.len -= 1;
        let v = self.$vals[e];
        // Compact once half the entries are removed ones.
        if (self.$keys.len - self.len) * 2 > self.$keys.len {
            self.$rebuild(self.$slots.len);
        }
        Some(v)
    }

    /** Removes every entry. */
    fun clear(mut self) {
        self = $map_of([], []);
    }

    /** The keys, in order. */
    fun keys(self): K[] {
        let mut out: K[] = [];
        for e in 0..self.$keys.len {
            if self.$live[e] {
                out.push(self.$keys[e]);
            }
        }
        out
    }

    /** The values, in their keys' order. */
    fun values(self): V[] {
        let mut out: V[] = [];
        for e in 0..self.$keys.len {
            if self.$live[e] {
                out.push(self.$vals[e]);
            }
        }
        out
    }

    /** An iterator of the entries as `(key, value)`, in order. */
    fun iter(self): Map<K, V> = Map { $at: 0, ..self };
}

impl<K: Key, V> Iter<(K, V)> for Map<K, V> {
    /** The entries as `(key, value)`, in order: `for (k, v) of m`. */
    fun next(mut self): Option<(K, V)> {
        while self.$at < self.$keys.len {
            let e = self.$at;
            self.$at += 1;
            if self.$live[e] {
                return Some((self.$keys[e], self.$vals[e]));
            }
        }
        None
    }
}

// `==` on maps needs equal values too.
impl<K: Key, V: Eq> Map<K, V> {
    /** True if both have the same keys with equal values, in any order: `==`. */
    fun same(self, other: Map<K, V>): bool {
        if self.len != other.len {
            return false;
        }
        for (k, v) of self.iter() {
            if other.get(k) != Some(v) {
                return false;
            }
        }
        true
    }
}

impl<T: Key> Set<T> {
    /** True if `x` is in the set. */
    fun has(self, x: T): bool = self.$map.has(x);

    /** Adds `x`; true if it wasn't there. */
    fun insert(mut self, x: T): bool {
        if self.$map.has(x) {
            return false;
        }
        self.$map.insert(x, true);
        self.len += 1;
        true
    }

    /** Removes `x`; true if it was there. */
    fun remove(mut self, x: T): bool {
        let gone = self.$map.remove(x).is_some();
        if gone {
            self.len -= 1;
        }
        gone
    }

    /** Removes every value. */
    fun clear(mut self) {
        self.$map.clear();
        self.len = 0;
    }

    /** An iterator of the values, in order. */
    fun iter(self): Set<T> = Set { len: self.len, $map: self.$map.iter() };

    /** The values of both: `self`'s, then `other`'s new ones. */
    fun union(self, other: Set<T>): Set<T> {
        let mut out = self.iter();
        for x of other.iter() {
            out.insert(x);
        }
        out
    }

    /** The values in both, in `self`'s order. */
    fun intersect(self, other: Set<T>): Set<T> {
        let mut out: Set<T> = $set_of([]);
        for x of self.iter() {
            if other.has(x) {
                out.insert(x);
            }
        }
        out
    }

    /** The values of `self` not in `other`. */
    fun minus(self, other: Set<T>): Set<T> {
        let mut out: Set<T> = $set_of([]);
        for x of self.iter() {
            if !other.has(x) {
                out.insert(x);
            }
        }
        out
    }

    /** True if both hold the same values, in any order: `==`. */
    fun same(self, other: Set<T>): bool {
        if self.len != other.len {
            return false;
        }
        for x of self.iter() {
            if !other.has(x) {
                return false;
            }
        }
        true
    }
}

impl<T: Key> Iter<T> for Set<T> {
    /** The values, in order: `for x of s`. */
    fun next(mut self): Option<T> = match self.$map.next() {
        .Some((x, _)) => Some(x),
        .None => None,
    };
}

/** A map of an iterator's `(key, value)` pairs; a later key replaces an earlier one's value. */
fun iter_collect_map<K: Key, V>(it: Iter<(K, V)>): Map<K, V> {
    let mut m: Map<K, V> = $map_of([], []);
    for (k, v) of it {
        m.insert(k, v);
    }
    m
}

/** A set of an iterator's values. */
fun iter_collect_set<T: Key>(it: Iter<T>): Set<T> {
    let mut s: Set<T> = $set_of([]);
    for x of it {
        s.insert(x);
    }
    s
}

// ---- `and_then`: at the prelude's end, so no earlier line moves ----

impl<T> Option<T> {
    /** `f` of the value, or `None`: chains steps that may each give nothing: `o.and_then(f)`. */
    fun and_then<U>(self, f: fun(T): Option<U>): Option<U> {
        let o = self;
        match o {
        .Some(x) => f(x),
        .None => None,
    }
    }
}

impl<T, E> Result<T, E> {
    /** `f` of the `Ok` value, or the `Err` unchanged: chains steps that may each fail: `r.and_then(f)`. */
    fun and_then<U>(self, f: fun(T): Result<U, E>): Result<U, E> {
        let r = self;
        match r {
        .Ok(x) => f(x),
        .Err(e) => Err(e),
    }
    }
}
